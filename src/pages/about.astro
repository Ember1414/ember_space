---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title="关于" description={`关于 ${SITE.author}`}>
  <h1 class="page-title anim"><span style="color: var(--accent-text);">$</span> cat about.txt</h1>

  <div class="term anim" style="animation-delay: 0.1s; margin-top: 1.5rem;">
    <div class="term-bar">
      <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
      <span class="term-title">about.txt — 简介</span>
    </div>
    <div class="term-body prose">
      <p>
        你好，我是 <strong style="color: var(--accent-text);">{SITE.author}</strong>。
        {SITE.description}
      </p>
      <p>
        在这里我记录技术探索、项目心得，偶尔写点生活随笔。
        如果文章对你有帮助，欢迎通过 RSS 订阅或邮件联系我。
      </p>
    </div>
  </div>

  <ul class="about-facts anim" style="animation-delay: 0.2s;">
    <li><span class="k">当前状态</span> 保持好奇，持续构建</li>
    <li><span class="k">技术偏好</span> TypeScript / Python / Rust，喜欢简单直接的方案</li>
    <li><span class="k">坐标</span> 地球 · UTC+8</li>
    <li><span class="k">联系方式</span> <a href={SITE.social.email}>{SITE.social.email.replace('mailto:', '')}</a></li>
    <li><span class="k">GitHub</span> <a href={SITE.social.github} target="_blank" rel="noopener">{SITE.social.github.replace('https://', '')}</a></li>
  </ul>

  <h2 style="font-size: 1.2rem; margin: 2.5rem 0 1rem;"><span style="color: var(--accent-text);">##</span> 关于本站</h2>
  <div class="prose">
    <ul>
      <li>使用 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，部署在 <a href="https://pages.cloudflare.com" target="_blank" rel="noopener">Cloudflare Pages</a>，全球 CDN 加速</li>
      <li>主题为手写的暗色终端风格，支持亮色切换，无任何跟踪脚本</li>
      <li>评论基于 GitHub Discussions（giscus），搜索由 Pagefind 在浏览器本地完成</li>
      <li>源码开放，欢迎 Fork 后改造成你自己的博客</li>
    </ul>
  </div>
</BaseLayout>
