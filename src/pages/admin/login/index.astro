---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="登录" minimal>
  <section class="auth-card card" aria-labelledby="login-title">
    <p class="eyebrow">EMBER / ADMIN</p>
    <h1 id="login-title" class="page-title">登录后台</h1>
    <p class="auth-lede">使用你的账号管理文章、草稿和协作者。</p>
    <form data-login-form>
      <div class="field"><label for="login-username">账号</label><input id="login-username" name="username" autocomplete="username" required /></div>
      <div class="field"><label for="login-password">密码</label><input id="login-password" name="password" type="password" autocomplete="current-password" required /></div>
      <div class="auth-message" data-login-message role="alert"></div>
      <button class="button button--primary" type="submit">登录</button>
    </form>
    <p class="auth-foot"><a href="/">返回网站首页</a></p>
  </section>
</AdminLayout>

<script>
  const loginForm = document.querySelector<HTMLFormElement>('[data-login-form]');
  const loginMessage = document.querySelector<HTMLElement>('[data-login-message]');
  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (loginMessage) loginMessage.textContent = '正在验证…';
    const values = Object.fromEntries(new FormData(loginForm).entries());
    const username = String(values.username || '').trim();
    const body = { ...values, username, email: username };
    try {
      const response = await fetch('/api/auth/login', { method: 'POST', credentials: 'include', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await response.json().catch(() => ({})) as { error?: string | { message?: string }; message?: string };
      if (!response.ok) throw new Error(typeof data.error === 'string' ? data.error : data.error?.message || data.message || '账号或密码不正确。');
      window.location.href = '/admin/';
    } catch (error) {
      if (loginMessage) loginMessage.textContent = error instanceof Error ? error.message : '登录失败，请稍后重试。';
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .auth-card { width: min(100%, 480px); margin: 8vh auto 0; padding: clamp(24px, 5vw, 44px); }
  .auth-card .page-title { margin-bottom: 10px; }
  .auth-lede { margin: 0 0 28px; color: var(--text-muted); }
  .auth-card form { display: grid; gap: 18px; }
  .field { display: grid; gap: 6px; }
  .field label { color: var(--text-soft); font-size: 0.84rem; font-weight: 750; }
  .field input { width: 100%; padding: 0.7rem 0.75rem; border: 1px solid var(--border-strong); border-radius: 4px; background: var(--surface); color: var(--text); }
  .auth-message { min-height: 1.4em; color: var(--accent-strong); font-size: 0.86rem; }
  .auth-foot { margin: 24px 0 0; color: var(--text-muted); font-size: 0.84rem; }
</style>
