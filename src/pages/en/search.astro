---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchPage from '../../components/SearchPage.astro';
import { t, type Lang } from '../../i18n/ui';

const lang: Lang = 'en';
---

<BaseLayout
  lang={lang}
  title={t(lang, 'nav.search')}
  description="Search posts and projects on Ember"
  canonicalPath="/en/search/"
  alternatePath="/search/"
>
  <SearchPage lang={lang} />
</BaseLayout>
