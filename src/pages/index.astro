---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import RepoCard from '../components/RepoCard.astro';
import { SITE } from '../consts';
import { getGitHubRepos } from '../lib/github';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const repos = (await getGitHubRepos()).slice(0, 4);
---

<BaseLayout>
  <section class="hero anim">
    <div class="term">
      <div class="term-bar">
        <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
        <span class="term-title">ember@blog: ~</span>
      </div>
      <div class="term-body">
        <p class="prompt" style="margin: 0 0 0.6rem;">whoami</p>
        <h1 class="type-line" aria-label="> 你好，我是 Ember">&gt; 你好，我是 <span class="name">{SITE.author}</span><span class="cursor" aria-hidden="true"></span></h1>
        <p class="out">{SITE.tagline}。</p>
        <p class="muted">// {SITE.description}</p>
        <p class="prompt" style="margin: 0.8rem 0 0;">ls ./links</p>
        <div class="hero-links">
          <a href={SITE.social.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a href={SITE.social.email}>Email</a>
          <a href="/rss.xml">RSS</a>
          <a href="/about/">关于我 →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="anim" style="animation-delay: 0.15s;">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/posts/">查看全部 →</a>
    </div>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="anim" style="animation-delay: 0.28s; margin-top: 3rem;">
    <div class="section-head">
      <h2>我的项目</h2>
      <a href="/projects/">查看全部 →</a>
    </div>
    <div class="grid">
      {repos.map((repo) => <RepoCard repo={repo} />)}
    </div>
  </section>
</BaseLayout>

<script>
  // 首页打字机："> 你好，我是 Ember" 逐字打出
  (function () {
    const h1 = document.querySelector<HTMLElement>('.type-line');
    if (!h1) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const prefix = h1.firstChild as Text;
    const name = h1.querySelector<HTMLElement>('.name');
    if (!name) return;

    if (reduced) {
      document.documentElement.classList.remove('js-typing');
      return;
    }

    const prefixText = prefix.textContent ?? '';
    const nameText = name.textContent ?? '';
    prefix.textContent = '';
    name.textContent = '';
    document.documentElement.classList.remove('js-typing');

    const total = prefixText.length + nameText.length;
    let step = 0;
    (function tick() {
      step++;
      if (step <= prefixText.length) {
        prefix.textContent = prefixText.slice(0, step);
      } else {
        name.textContent = nameText.slice(0, step - prefixText.length);
      }
      if (step < total) setTimeout(tick, 70);
    })();
  })();
</script>
