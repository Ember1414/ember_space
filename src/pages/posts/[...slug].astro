---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPage from '../../templates/PostPage.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  alternatePath: string | null;
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts
    .filter(({ data }) => data.lang === 'zh')
    .map((post) => {
      const counterpart = post.data.translationKey
        ? posts.find(({ data }) => data.lang === 'en' && data.translationKey === post.data.translationKey)
        : undefined;

      return {
        params: { slug: post.id },
        props: {
          post,
          alternatePath: counterpart ? `/en/posts/${counterpart.id}/` : null,
        },
      };
    });
}

const { post, alternatePath } = Astro.props as Props;
const canonicalPath = `/posts/${post.id}/`;
---

<BaseLayout
  lang="zh"
  title={post.data.title}
  description={post.data.description}
  canonicalPath={canonicalPath}
  alternatePath={alternatePath}
  image={post.data.cover?.src}
  pageType="article"
  publishedDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
>
  <PostPage lang="zh" post={post} />
</BaseLayout>
