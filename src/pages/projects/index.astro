---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RepoCard from '../../components/RepoCard.astro';
import { getGitHubRepos } from '../../lib/github';
import { SITE } from '../../consts';

const featured = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const repos = await getGitHubRepos();
---

<BaseLayout title="项目" description="我做过的项目与开源仓库">
  <div data-pagefind-body data-pagefind-meta="type:项目">
    <span hidden data-pagefind-meta="title:项目与开源仓库"></span>
    <h1 class="page-title anim" data-pagefind-ignore><span style="color: var(--accent-text);">$</span> ls ./projects</h1>
    <p class="page-sub anim" style="animation-delay: 0.08s;" data-pagefind-ignore>做过的东西，都在这里</p>

  {featured.length > 0 && (
    <section class="anim" style="animation-delay: 0.15s;">
      <div class="section-head">
        <h2>精选项目</h2>
      </div>
      <div class="grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <section class="anim" style={`animation-delay: ${featured.length > 0 ? '0.28' : '0.15'}s; ${featured.length > 0 ? 'margin-top: 3rem;' : ''}`}>
    <div class="section-head">
      <h2>GitHub 仓库</h2>
      <a href={SITE.social.github} target="_blank" rel="noopener">全部仓库 ↗</a>
    </div>
    <div class="grid">
      {repos.map((repo) => <RepoCard repo={repo} />)}
    </div>
  </section>
  </div>
</BaseLayout>
