---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import emberHero from '../assets/ember-hero.webp';
import { SITE } from '../consts';
import { SITE_I18N, t, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  wide?: boolean;
  alternatePath?: string | null;
  canonicalPath?: string;
  image?: string;
  pageType?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
}

const {
  lang = 'zh',
  title,
  description,
  wide = false,
  alternatePath,
  canonicalPath,
  image,
  pageType = 'website',
  publishedDate,
  updatedDate,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE_I18N[lang].tagline}`;
const desc = description ?? SITE_I18N[lang].description;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? SITE.url);
const alternateLang: Lang = lang === 'zh' ? 'en' : 'zh';
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site ?? SITE.url) : null;
const imageUrl = new URL(image ?? emberHero.src, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e1110" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f5" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="alternate" hreflang={lang === 'zh' ? 'zh-CN' : 'en'} href={canonicalUrl.href} />
    {alternateUrl && <link rel="alternate" hreflang={alternateLang === 'zh' ? 'zh-CN' : 'en'} href={alternateUrl.href} />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {alternateUrl && <meta property="og:locale:alternate" content={alternateLang === 'zh' ? 'zh_CN' : 'en_US'} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title ?? SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (systemDark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(lang, 'a11y.skip')}</a>
    <Header lang={lang} alternatePath={alternatePath} />
    <main id="main-content" class:list={['site-main', { 'site-main--home': wide }]} tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<script>
  function syncThemeControls() {
    const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    document.querySelectorAll<HTMLButtonElement>('.js-theme-toggle').forEach((button) => {
      const label = current === 'dark' ? button.dataset.labelLight : button.dataset.labelDark;
      if (label) button.setAttribute('aria-label', label);
    });
  }

  syncThemeControls();
  document.querySelectorAll<HTMLButtonElement>('.js-theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      syncThemeControls();
      document.dispatchEvent(new CustomEvent('ember:theme', { detail: { theme: next } }));
    });
  });
</script>
