---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // 防 FOUC：默认暗色（站点主打风格），用户手动切换后记住选择
      (function () {
        var t = localStorage.getItem('theme') || 'dark';
        document.documentElement.dataset.theme = t;
      })();
      // 打字机前置：仅首页、且用户未偏好减弱动效时，先隐藏打字行；2.5s 兜底强制显示
      (function () {
        try {
          if (
            location.pathname === '/' &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            document.documentElement.classList.add('js-typing');
          }
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js-anim');
          }
        } catch {}
        setTimeout(function () {
          document.documentElement.classList.remove('js-typing');
          // 兜底：仅当 reveal 脚本未成功初始化时才强制显示（正常时 __revealOk 已置位）
          if (!window.__revealOk) {
            document.querySelectorAll('.anim').forEach(function (el) {
              el.classList.add('is-visible');
            });
          }
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // 滚动显现：.anim 元素进入视口时触发 fade-up；元素自带的 animation-delay 依次错开
  (function () {
    const els = Array.from(document.querySelectorAll<HTMLElement>('.anim'));
    const root = document.documentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced || !('IntersectionObserver' in window) || !root.classList.contains('js-anim')) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
    );
    els.forEach((el) => io.observe(el));
    window.__revealOk = true;
  })();
</script>
