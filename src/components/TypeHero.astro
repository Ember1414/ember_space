---
import { SITE } from '../consts';
import { t, SITE_I18N, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
---

<div class="term">
  <div class="term-bar">
    <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
    <span class="term-title">ember@blog: ~</span>
  </div>
  <div class="term-body">
    <p class="prompt" style="margin: 0 0 0.6rem;">whoami</p>
    <h1 class="type-line" aria-label={`${t(lang, 'home.intro')} ${SITE.author}`}>&gt; {t(lang, 'home.intro')} <span class="name">{SITE.author}</span><span class="cursor" aria-hidden="true"></span></h1>
    <p class="out">{SITE_I18N[lang].tagline}</p>
    <p class="muted">// {SITE_I18N[lang].description}</p>
    <p class="prompt" style="margin: 0.8rem 0 0;">{t(lang, 'home.links')}</p>
    <div class="hero-links">
      <a href={SITE.social.github} target="_blank" rel="noopener">GitHub ↗</a>
      <a href={SITE.social.email}>Email</a>
      <a href="/rss.xml">RSS</a>
      <a href={lang === 'zh' ? '/about/' : '/en/about/'}>{t(lang, 'home.about')} →</a>
    </div>
  </div>
</div>

<script>
  // 首页打字机：h1 文本逐字打出（文本从 DOM 读取，语言无关）
  (function () {
    const h1 = document.querySelector<HTMLElement>('.type-line');
    if (!h1) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const prefix = h1.firstChild as Text;
    const name = h1.querySelector<HTMLElement>('.name');
    if (!name) return;

    if (reduced) {
      document.documentElement.classList.remove('js-typing');
      return;
    }

    const prefixText = prefix.textContent ?? '';
    const nameText = name.textContent ?? '';
    prefix.textContent = '';
    name.textContent = '';
    document.documentElement.classList.remove('js-typing');

    const total = prefixText.length + nameText.length;
    let step = 0;
    (function tick() {
      step++;
      if (step <= prefixText.length) {
        prefix.textContent = prefixText.slice(0, step);
      } else {
        name.textContent = nameText.slice(0, step - prefixText.length);
      }
      if (step < total) setTimeout(tick, 70);
    })();
  })();
</script>
