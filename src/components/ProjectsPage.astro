---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ExternalLink, Github } from 'lucide-astro';
import { SITE } from '../consts';
import { t, type Lang } from '../i18n/ui';
import { getGitHubRepos, repositoryUrlKey, type Repo } from '../lib/github';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import RepoCard from './RepoCard.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const isZh = lang === 'zh';
const base = isZh ? '' : '/en';
const projects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const repos = await getGitHubRepos();

type CatalogItem =
  | { kind: 'project'; project: CollectionEntry<'projects'>; repo: Repo | null }
  | { kind: 'repo'; repo: Repo };

const projectsByRepository = new Map(
  projects.flatMap((project) => {
    const key = repositoryUrlKey(project.data.repo);
    return key ? [[key, project] as const] : [];
  }),
);
const matchedProjectIds = new Set<string>();
const catalog: CatalogItem[] = repos.map((repo) => {
  const project = projectsByRepository.get(repositoryUrlKey(repo.html_url) ?? '');
  if (!project) return { kind: 'repo', repo };
  matchedProjectIds.add(project.id);
  return { kind: 'project', project, repo };
});
catalog.push(
  ...projects
    .filter(({ id }) => !matchedProjectIds.has(id))
    .map((project): CatalogItem => ({ kind: 'project', project, repo: null })),
);

const labels = isZh
  ? {
      eyebrow: 'PROJECTS / 构建记录',
      all: '全部项目',
      emptyTitle: '项目列表暂时不可用',
      emptyText: '你仍可前往 GitHub 查看全部公开仓库。',
    }
  : {
      eyebrow: 'PROJECTS / BUILD NOTES',
      all: 'All projects',
      emptyTitle: 'Project data is unavailable',
      emptyText: 'You can still browse every public repository on GitHub.',
    };
---

<BaseLayout
  lang={lang}
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.subtitle')}
  canonicalPath={`${base}/projects/`}
  alternatePath={isZh ? '/en/projects/' : '/projects/'}
>
  <div class="projects-page" data-pagefind-body data-pagefind-filter={`lang:${lang}`} data-pagefind-meta={`lang:${lang}`}>
    <div data-pagefind-filter="type:projects" data-pagefind-meta="type:projects">
      <header class="page-intro anim">
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1 class="page-title">{t(lang, 'projects.title')}</h1>
        <p class="page-sub">{t(lang, 'projects.subtitle')}</p>
      </header>

      <section class="projects-section anim" aria-labelledby={`all-projects-${lang}`}>
        <header class="section-head">
          <div>
            <p class="eyebrow"><Github size={15} aria-hidden="true" /> OPEN SOURCE / GITHUB</p>
            <h2 id={`all-projects-${lang}`}>{labels.all}</h2>
          </div>
          <a class="section-link github-link" href={SITE.social.github} target="_blank" rel="noopener">{t(lang, 'projects.allOnGithub')}<ExternalLink size={16} aria-hidden="true" /></a>
        </header>

        {catalog.length > 0 ? (
          <div class="project-grid">
            {catalog.map((item) => item.kind === 'project'
              ? <ProjectCard
                  project={item.project}
                  lang={lang}
                  updatedAt={item.repo?.pushed_at}
                  stars={item.repo?.stargazers_count}
                />
              : <RepoCard repo={item.repo} lang={lang} />)}
          </div>
        ) : (
          <div class="empty-state"><h3>{labels.emptyTitle}</h3><p>{labels.emptyText}</p></div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page { width: 100%; }
  .section-head .eyebrow { display: flex; align-items: center; gap: 7px; margin-bottom: 0.45rem; }
  .github-link { display: inline-flex; min-height: 44px; align-items: center; gap: 7px; font-weight: 700; }
</style>
