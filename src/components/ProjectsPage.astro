---
import { getCollection } from 'astro:content';
import { ExternalLink, Github } from 'lucide-astro';
import { SITE } from '../consts';
import { t, type Lang } from '../i18n/ui';
import { getGitHubRepos, repositoryUrlKey, type Repo } from '../lib/github';
import { getContributions } from '../lib/contributions';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import RepoCard from './RepoCard.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const isZh = lang === 'zh';
const base = isZh ? '' : '/en';
const projects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const repos = await getGitHubRepos();

// 精选项目（内容库策划）永远排在自动同步的 GitHub 仓库之前；同一仓库不重复出现
const repoByKey = new Map(repos.map((repo) => [repositoryUrlKey(repo.html_url) ?? '', repo] as const));
const curated: { project: (typeof projects)[number]; repo: Repo | null }[] = projects.map((project) => ({
  project,
  repo: repoByKey.get(repositoryUrlKey(project.data.repo) ?? '') ?? null,
}));
const curatedRepoKeys = new Set(
  curated.flatMap(({ repo }) => {
    const key = repo ? repositoryUrlKey(repo.html_url) : null;
    return key ? [key] : [];
  }),
);
const uncuratedRepos = repos.filter((repo) => !curatedRepoKeys.has(repositoryUrlKey(repo.html_url) ?? ''));

const labels = isZh
  ? {
      eyebrow: 'PROJECTS / 构建记录',
      emptyTitle: '项目列表暂时不可用',
      emptyText: '你仍可前往 GitHub 查看全部公开仓库。',
      contributions: 'GITHUB / 贡献记录',
      contributionsAlt: 'GitHub 贡献热力图',
      totalPrefix: '过去一年',
      totalSuffix: '次贡献',
      less: '少',
      more: '多',
    }
  : {
      eyebrow: 'PROJECTS / BUILD NOTES',
      emptyTitle: 'Project data is unavailable',
      emptyText: 'You can still browse every public repository on GitHub.',
      contributions: 'GITHUB / CONTRIBUTIONS',
      contributionsAlt: 'GitHub contribution heatmap',
      totalPrefix: '',
      totalSuffix: 'contributions in the last year',
      less: 'Less',
      more: 'More',
    };
const contributions = await getContributions();
---

<BaseLayout
  lang={lang}
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.subtitle')}
  canonicalPath={`${base}/projects/`}
  alternatePath={isZh ? '/en/projects/' : '/projects/'}
>
  <div class="projects-page" data-pagefind-body data-pagefind-filter={`lang:${lang}`} data-pagefind-meta={`lang:${lang}`}>
    <div data-pagefind-filter="type:projects" data-pagefind-meta="type:projects">
      <header class="page-intro anim">
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1 class="page-title">{t(lang, 'projects.title')}</h1>
        <p class="page-sub">{t(lang, 'projects.subtitle')}</p>
      </header>

      {contributions && (
        <section class="contributions anim" aria-label={labels.contributions}>
          <header class="section-head contrib-head">
            <p class="eyebrow"><Github size={15} aria-hidden="true" /> {labels.contributions}</p>
            <a class="contrib-total" href={SITE.social.github} target="_blank" rel="noopener">
              {labels.totalPrefix && <span>{labels.totalPrefix}</span>}
              <strong>{contributions.total}</strong>
              <span>{labels.totalSuffix}</span>
              <ExternalLink size={14} aria-hidden="true" />
            </a>
          </header>
          <a class="contributions-frame" href={SITE.social.github} target="_blank" rel="noopener" aria-label={labels.contributionsAlt}>
            <div class="contrib-graph" role="img" aria-label={labels.contributionsAlt}>
              {contributions.weeks.map((week, weekIndex) => (
                <span class="contrib-week">
                  {week.map((day, dayIndex) => day
                    ? <span class={`contrib-cell level-${day.level}`} title={`${day.date} · ${day.count}`} />
                    : <span class="contrib-cell empty" data-slot={`${weekIndex}-${dayIndex}`} />)}
                </span>
              ))}
            </div>
            <div class="contrib-foot">
              <span class="contrib-scale-label">{labels.less}</span>
              <span class="contrib-cell level-0" />
              <span class="contrib-cell level-1" />
              <span class="contrib-cell level-2" />
              <span class="contrib-cell level-3" />
              <span class="contrib-cell level-4" />
              <span class="contrib-scale-label">{labels.more}</span>
            </div>
          </a>
        </section>
      )}

      {curated.length > 0 && (
        <section class="projects-section anim" aria-labelledby={`featured-projects-${lang}`}>
          <header class="section-head">
            <h2 id={`featured-projects-${lang}`}>{t(lang, 'projects.featured')}</h2>
          </header>
          <div class="project-grid">
            {curated.map(({ project, repo }) => (
              <ProjectCard
                project={project}
                lang={lang}
                updatedAt={repo?.pushed_at}
                stars={repo?.stargazers_count}
              />
            ))}
          </div>
        </section>
      )}

      {uncuratedRepos.length > 0 && (
        <section class="projects-section anim" aria-labelledby={`repo-list-${lang}`}>
          <header class="section-head">
            <div>
              <p class="eyebrow"><Github size={15} aria-hidden="true" /> {t(lang, 'projects.reposEyebrow')}</p>
              <h2 id={`repo-list-${lang}`}>{t(lang, 'projects.repos')}</h2>
            </div>
            <a class="section-link github-link" href={SITE.social.github} target="_blank" rel="noopener">{t(lang, 'projects.allOnGithub')}<ExternalLink size={16} aria-hidden="true" /></a>
          </header>
          <div class="project-grid">
            {uncuratedRepos.map((repo) => <RepoCard repo={repo} lang={lang} />)}
          </div>
        </section>
      )}

      {curated.length === 0 && uncuratedRepos.length === 0 && (
        <div class="empty-state"><h3>{labels.emptyTitle}</h3><p>{labels.emptyText}</p></div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page { width: 100%; }
  .projects-section + .projects-section { margin-top: 56px; }
  .section-head .eyebrow { display: flex; align-items: center; gap: 7px; margin-bottom: 0.45rem; }
  .github-link { display: inline-flex; min-height: 44px; align-items: center; gap: 7px; font-weight: 700; }
  .contributions { margin-top: 36px; }
  .contributions + .projects-section { margin-top: 56px; }
  .contrib-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 12px; }
  .contrib-total { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.78rem; text-decoration: none; }
  .contrib-total strong { color: var(--accent); font-size: 0.95rem; }
  .contrib-total:hover { color: var(--accent-strong); }
  .contributions-frame {
    display: block;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .contributions-frame:hover { border-color: var(--border-strong); }
  .contrib-graph {
    display: flex;
    gap: 3px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .contrib-week { display: grid; grid-template-rows: repeat(7, 11px); gap: 3px; }
  .contrib-cell {
    width: 11px;
    height: 11px;
    border-radius: 2.5px;
    background: var(--surface-soft);
  }
  .contrib-cell.empty { background: transparent; }
  .contrib-cell.level-1 { background: color-mix(in srgb, var(--accent) 28%, var(--surface-soft)); }
  .contrib-cell.level-2 { background: color-mix(in srgb, var(--accent) 52%, var(--surface-soft)); }
  .contrib-cell.level-3 { background: color-mix(in srgb, var(--accent) 78%, var(--surface-soft)); }
  .contrib-cell.level-4 { background: var(--accent); }
  .contrib-foot { display: flex; align-items: center; gap: 4px; margin-top: 10px; }
  .contrib-scale-label { margin-right: 4px; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.68rem; }
  .contrib-foot .contrib-cell { width: 10px; height: 10px; }
</style>
