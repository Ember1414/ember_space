---
import { getCollection } from 'astro:content';
import { ExternalLink, Github } from 'lucide-astro';
import { SITE } from '../consts';
import { t, type Lang } from '../i18n/ui';
import { getGitHubRepos, repositoryUrlKey, type Repo } from '../lib/github';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import RepoCard from './RepoCard.astro';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const isZh = lang === 'zh';
const base = isZh ? '' : '/en';
const projects = (await getCollection('projects', ({ data }) => data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const repos = await getGitHubRepos();

// 精选项目（内容库策划）永远排在自动同步的 GitHub 仓库之前；同一仓库不重复出现
const repoByKey = new Map(repos.map((repo) => [repositoryUrlKey(repo.html_url) ?? '', repo] as const));
const curated: { project: (typeof projects)[number]; repo: Repo | null }[] = projects.map((project) => ({
  project,
  repo: repoByKey.get(repositoryUrlKey(project.data.repo) ?? '') ?? null,
}));
const curatedRepoKeys = new Set(
  curated.flatMap(({ repo }) => {
    const key = repo ? repositoryUrlKey(repo.html_url) : null;
    return key ? [key] : [];
  }),
);
const uncuratedRepos = repos.filter((repo) => !curatedRepoKeys.has(repositoryUrlKey(repo.html_url) ?? ''));

const labels = isZh
  ? { eyebrow: 'PROJECTS / 构建记录', emptyTitle: '项目列表暂时不可用', emptyText: '你仍可前往 GitHub 查看全部公开仓库。' }
  : { eyebrow: 'PROJECTS / BUILD NOTES', emptyTitle: 'Project data is unavailable', emptyText: 'You can still browse every public repository on GitHub.' };
---

<BaseLayout
  lang={lang}
  title={t(lang, 'projects.title')}
  description={t(lang, 'projects.subtitle')}
  canonicalPath={`${base}/projects/`}
  alternatePath={isZh ? '/en/projects/' : '/projects/'}
>
  <div class="projects-page" data-pagefind-body data-pagefind-filter={`lang:${lang}`} data-pagefind-meta={`lang:${lang}`}>
    <div data-pagefind-filter="type:projects" data-pagefind-meta="type:projects">
      <header class="page-intro anim">
        <p class="eyebrow">{labels.eyebrow}</p>
        <h1 class="page-title">{t(lang, 'projects.title')}</h1>
        <p class="page-sub">{t(lang, 'projects.subtitle')}</p>
      </header>

      {curated.length > 0 && (
        <section class="projects-section anim" aria-labelledby={`featured-projects-${lang}`}>
          <header class="section-head">
            <h2 id={`featured-projects-${lang}`}>{t(lang, 'projects.featured')}</h2>
          </header>
          <div class="project-grid">
            {curated.map(({ project, repo }) => (
              <ProjectCard
                project={project}
                lang={lang}
                updatedAt={repo?.pushed_at}
                stars={repo?.stargazers_count}
              />
            ))}
          </div>
        </section>
      )}

      {uncuratedRepos.length > 0 && (
        <section class="projects-section anim" aria-labelledby={`repo-list-${lang}`}>
          <header class="section-head">
            <div>
              <p class="eyebrow"><Github size={15} aria-hidden="true" /> {t(lang, 'projects.reposEyebrow')}</p>
              <h2 id={`repo-list-${lang}`}>{t(lang, 'projects.repos')}</h2>
            </div>
            <a class="section-link github-link" href={SITE.social.github} target="_blank" rel="noopener">{t(lang, 'projects.allOnGithub')}<ExternalLink size={16} aria-hidden="true" /></a>
          </header>
          <div class="project-grid">
            {uncuratedRepos.map((repo) => <RepoCard repo={repo} lang={lang} />)}
          </div>
        </section>
      )}

      {curated.length === 0 && uncuratedRepos.length === 0 && (
        <div class="empty-state"><h3>{labels.emptyTitle}</h3><p>{labels.emptyText}</p></div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .projects-page { width: 100%; }
  .projects-section + .projects-section { margin-top: 56px; }
  .section-head .eyebrow { display: flex; align-items: center; gap: 7px; margin-bottom: 0.45rem; }
  .github-link { display: inline-flex; min-height: 44px; align-items: center; gap: 7px; font-weight: 700; }
</style>
