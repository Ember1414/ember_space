---
interface EditorPost {
  id?: string;
  title?: string;
  slug?: string;
  description?: string;
  content?: string;
  body?: string;
  tags?: string[];
  lang?: 'zh' | 'en';
  cover?: string;
  status?: 'draft' | 'published' | 'archived';
  featured?: boolean;
  pubDate?: string;
  updatedDate?: string;
  version?: number;
  authorId?: string | null;
}

interface Props {
  post?: EditorPost | null;
  postId?: string;
}

const { post = null, postId = '' } = Astro.props;
const requiresLoad = Boolean(postId && !post);
const initial = {
  id: (post?.id ?? postId) || null,
  title: post?.title ?? '',
  slug: post?.slug ?? '',
  description: post?.description ?? '',
  content: post?.content ?? post?.body ?? '',
  tags: post?.tags ?? [],
  lang: post?.lang ?? 'zh',
  cover: post?.cover ?? '',
  status: post?.status ?? 'draft',
  featured: post?.featured ?? false,
  pubDate: post?.pubDate ? String(post.pubDate).slice(0, 10) : new Date().toISOString().slice(0, 10),
  updatedDate: post?.updatedDate ? String(post.updatedDate).slice(0, 10) : '',
  version: post?.version ?? null,
  authorId: post?.authorId ?? null,
};
const serialized = JSON.stringify(initial).replace(/</g, '\\u003c');
---

<form class="editor-shell" data-editor-form novalidate inert={requiresLoad} aria-busy={requiresLoad ? 'true' : 'false'}>
  <div class="editor-toolbar">
    <div>
      <p class="eyebrow">EDITOR / MARKDOWN</p>
      <h1 class="page-title">{post || postId ? '编辑文章' : '新建文章'}</h1>
    </div>
    <div class="button-row editor-actions">
      <a class="button button--secondary" href="/admin/">取消</a>
      <button class="button button--secondary" type="button" data-save-draft>保存草稿</button>
      {(post || postId) && <button class="button button--secondary" type="button" data-archive data-owner-only hidden>撤回文章</button>}
      <button class="button button--primary" type="button" data-publish>发布文章</button>
    </div>
  </div>

  <div class="editor-message" data-editor-message role="status" aria-live="polite">{requiresLoad ? '正在加载文章…' : ''}</div>

  <div class="editor-fields card">
    <div class="field field--wide">
      <label for="post-title">标题 <span aria-hidden="true">*</span></label>
      <input id="post-title" name="title" required autocomplete="off" placeholder="文章标题" />
    </div>
    <div class="field">
      <label for="post-slug">URL 标识</label>
      <input id="post-slug" name="slug" autocomplete="off" placeholder="留空则由标题生成" />
      <small>只使用字母、数字和短横线。</small>
    </div>
    <div class="field">
      <label for="post-date">发布日期</label>
      <input id="post-date" name="pubDate" type="date" />
    </div>
    <div class="field field--wide">
      <label for="post-description">摘要 <span aria-hidden="true">*</span></label>
      <textarea id="post-description" name="description" rows="2" required placeholder="用于首页、分享卡片和 RSS 的简短介绍"></textarea>
    </div>
    <div class="field">
      <label for="post-tags">标签</label>
      <input id="post-tags" name="tags" autocomplete="off" placeholder="Astro, Cloudflare, 工程" />
      <small>多个标签用逗号分隔。</small>
    </div>
    <div class="field">
      <label for="post-lang">语言</label>
      <select id="post-lang" name="lang"><option value="zh">中文</option><option value="en">English</option></select>
    </div>
    <div class="field">
      <label for="post-cover">封面地址</label>
      <input id="post-cover" name="cover" type="url" autocomplete="off" placeholder="https://…" />
    </div>
    <div class="field field-checks">
      <label class="check-label"><input id="post-featured" name="featured" type="checkbox" /> <span>设为精选文章</span></label>
      <label for="post-status">状态</label>
      <select id="post-status" name="status"><option value="draft">草稿</option><option value="published">已发布</option><option value="archived" data-owner-only hidden>已撤回</option></select>
    </div>
  </div>

  <div class="editor-tabs" role="tablist" aria-label="编辑器视图">
    <button type="button" class="editor-tab is-active" role="tab" aria-selected="true" data-editor-tab="edit">编辑</button>
    <button type="button" class="editor-tab" role="tab" aria-selected="false" data-editor-tab="preview">预览</button>
  </div>
  <div class="editor-grid">
    <section class="editor-pane editor-pane--write" data-editor-pane="edit" aria-label="Markdown 编辑区">
      <div class="md-toolbar" role="toolbar" aria-label="Markdown 工具栏">
        <button type="button" class="md-tool" data-md="h2" title="二级标题">H2</button>
        <button type="button" class="md-tool" data-md="h3" title="三级标题">H3</button>
        <button type="button" class="md-tool" data-md="h4" title="四级标题">H4</button>
        <span class="md-sep" aria-hidden="true"></span>
        <button type="button" class="md-tool" data-md="bold" title="粗体（Ctrl+B）"><strong>B</strong></button>
        <button type="button" class="md-tool" data-md="italic" title="斜体（Ctrl+I）"><em>I</em></button>
        <button type="button" class="md-tool" data-md="strike" title="删除线"><s>S</s></button>
        <button type="button" class="md-tool" data-md="code" title="行内代码">`</button>
        <span class="md-sep" aria-hidden="true"></span>
        <button type="button" class="md-tool" data-md="quote" title="引用">引用</button>
        <button type="button" class="md-tool" data-md="list" title="无序列表">列表</button>
        <button type="button" class="md-tool" data-md="olist" title="有序列表">1. 列表</button>
        <button type="button" class="md-tool" data-md="table" title="插入表格">表格</button>
        <button type="button" class="md-tool" data-md="codeblock" title="代码块">代码块</button>
        <button type="button" class="md-tool" data-md="hr" title="分割线">—</button>
        <span class="md-sep" aria-hidden="true"></span>
        <button type="button" class="md-tool" data-md="link" title="链接（Ctrl+K）">链接</button>
        <button type="button" class="md-tool" data-md-image title="插入图片（也可粘贴或拖拽）">图片</button>
        <button type="button" class="md-tool" data-md-gallery title="图片库：管理已上传的图片">图片库</button>
        <input type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/avif" multiple hidden data-md-file />
      </div>
      <label class="sr-only" for="post-content">Markdown 正文</label>
      <textarea id="post-content" name="content" class="markdown-input" spellcheck="false" placeholder={'# 开始写作\n\n支持 Markdown 标题、列表、引用、链接和代码块。'}></textarea>
    </section>
    <section class="editor-pane editor-pane--preview" data-editor-pane="preview" aria-label="文章预览">
      <div class="prose preview-content" data-preview><p class="preview-placeholder">在左侧输入 Markdown，右侧会实时预览。</p></div>
    </section>
  </div>

  {(post || postId) && <button class="danger-link" type="button" data-delete hidden>删除这篇文章</button>}
  <p class="autosave-hint" data-autosave-hint>草稿会在停止编辑后自动保存。快捷键：Ctrl+B 粗体 · Ctrl+I 斜体 · Ctrl+K 链接。</p>

  <dialog class="gallery-dialog" data-gallery>
    <div class="gallery-head">
      <strong>图片库</strong>
      <button type="button" class="button button--secondary" data-gallery-close>关闭</button>
    </div>
    <p class="gallery-hint">这里列出所有上传过的图片。删除会从存储中永久移除，引用它的文章将无法显示，操作不可恢复。</p>
    <div class="gallery-grid" data-gallery-grid></div>
    <p class="gallery-empty" data-gallery-empty hidden>还没有上传过图片。</p>
  </dialog>
</form>

<script is:inline type="application/json" data-editor-initial set:html={serialized}></script>

<script>
  import { EditorLifecycle } from '../lib/admin/editor-lifecycle';
  import { safeMarkdownHtml } from '../lib/posts/render';

  const form = document.querySelector<HTMLFormElement>('[data-editor-form]')!;

  interface EditorValues {
    id: string | null;
    title: string;
    slug: string;
    description: string;
    content?: string;
    body?: string;
    tags: string[];
    lang: 'zh' | 'en';
    cover: string;
    status: 'draft' | 'published' | 'archived';
    featured: boolean;
    pubDate: string;
    updatedDate?: string;
    version: number | null;
    authorId?: string | null;
  }

  const initialData = document.querySelector<HTMLScriptElement>('[data-editor-initial]');
  const initial = JSON.parse(initialData?.textContent || '{}') as EditorValues;
  const message = form.querySelector<HTMLElement>('[data-editor-message]');
  const preview = form.querySelector<HTMLElement>('[data-preview]');
  const contentInput = form.querySelector<HTMLTextAreaElement>('#post-content');
  const slugInput = form.querySelector<HTMLInputElement>('#post-slug');
  const statusInput = form.querySelector('#post-status') as HTMLSelectElement | null;
  const draftButton = form.querySelector<HTMLButtonElement>('[data-save-draft]');
  const archiveButton = form.querySelector<HTMLButtonElement>('[data-archive]');
  const publishButton = form.querySelector<HTMLButtonElement>('[data-publish]');
  const deleteButton = form.querySelector<HTMLButtonElement>('[data-delete]');
  const tabs = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-editor-tab]'));
  const panes = Array.from(form.querySelectorAll<HTMLElement>('[data-editor-pane]'));
  let csrfToken = '';
  let currentUser: { id?: string; role?: string } | null = null;
  const lifecycle = new EditorLifecycle(Boolean(initial.id && !initial.title));
  let autosaveTimer = 0;
  let previewTimer = 0;

  // 删除按钮：所有者对所有文章可见；编辑只在自己名下的文章上可见（服务端同样强制校验）
  function updateDeleteVisibility() {
    if (!deleteButton || !initial.id) return;
    const canDelete = Boolean(currentUser && (currentUser.role === 'owner' || (initial.authorId && initial.authorId === currentUser.id)));
    deleteButton.hidden = !canDelete;
  }

  function setInteractive(value: boolean) {
    form.inert = !value;
    form.setAttribute('aria-busy', String(!value));
  }

  function markdownToHtml(markdown: string) {
    return markdown.trim()
      ? safeMarkdownHtml(markdown)
      : '<p class="preview-placeholder">在左侧输入 Markdown，右侧会实时预览。</p>';
  }

  function setMessage(text: string, kind = '') {
    if (!message) return;
    message.textContent = text;
    message.dataset.kind = kind;
  }

  function updatePreview() {
    if (preview) preview.innerHTML = markdownToHtml(contentInput?.value || '');
  }

  function schedulePreview() {
    window.clearTimeout(previewTimer);
    previewTimer = window.setTimeout(updatePreview, 120);
  }

  function setFields(values: Partial<EditorValues>) {
    const set = (selector: string, value: unknown) => {
      const element = form.querySelector(selector) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      if (element) element.value = value == null ? '' : String(value);
    };
    set('#post-title', values.title); set('#post-slug', values.slug); set('#post-description', values.description);
    set('#post-tags', (values.tags || []).join(', ')); set('#post-lang', values.lang || 'zh'); set('#post-cover', values.cover);
    set('#post-status', values.status || 'draft'); set('#post-date', values.pubDate || new Date().toISOString().slice(0, 10)); set('#post-content', values.content ?? values.body);
    const featured = form.querySelector<HTMLInputElement>('#post-featured'); if (featured) featured.checked = Boolean(values.featured);
  }
  setFields(initial);
  updatePreview();

  async function getCsrf() {
    if (csrfToken) return csrfToken;
    try {
      const response = await fetch('/api/auth/me', { credentials: 'include' });
      if (response.ok) {
        const data = await response.json() as { csrfToken?: string; csrf?: string; user?: { id?: string; role?: string } };
        csrfToken = data.csrfToken || data.csrf || '';
        currentUser = data.user ?? null;
        updateDeleteVisibility();
      }
    } catch { /* API may be unavailable while editing locally. */ }
    return csrfToken;
  }

  async function loadExisting() {
    if (!initial.id || initial.title) return;
    try {
      const response = await fetch(`/api/posts/${encodeURIComponent(initial.id)}`, { credentials: 'include' });
      if (response.status === 401) { window.location.href = '/admin/login/'; return; }
      if (!response.ok) throw new Error('文章不存在或暂时无法读取。');
      const data = await response.json() as { post?: Partial<EditorValues> } & Partial<EditorValues>;
      const values = data.post || data;
      window.clearTimeout(autosaveTimer);
      window.clearTimeout(previewTimer);
      setFields(values);
      Object.assign(initial, values);
      updateDeleteVisibility();
      lifecycle.loadSucceeded();
      setInteractive(true);
      setMessage('');
      updatePreview();
    } catch (error) {
      window.clearTimeout(autosaveTimer);
      window.clearTimeout(previewTimer);
      lifecycle.loadFailed();
      setInteractive(false);
      setMessage(error instanceof Error ? error.message : '读取文章失败。', 'error');
    }
  }
  loadExisting();
  // 编辑已有文章时需要当前用户身份来决定删除按钮可见性
  if (deleteButton) void getCsrf();

  function formData(statusOverride?: 'draft' | 'published' | 'archived') {
    const tags = (form.querySelector<HTMLInputElement>('#post-tags')?.value || '').split(',').map((tag) => tag.trim()).filter(Boolean);
    const body = contentInput?.value || '';
    return {
      title: form.querySelector<HTMLInputElement>('#post-title')?.value.trim() || '',
      slug: slugInput?.value.trim() || '',
      description: form.querySelector<HTMLTextAreaElement>('#post-description')?.value.trim() || '',
      body,
      content: body,
      tags,
      lang: (form.querySelector('#post-lang') as HTMLSelectElement | null)?.value || 'zh',
      cover: form.querySelector<HTMLInputElement>('#post-cover')?.value.trim() || '',
      status: statusOverride || statusInput?.value || 'draft',
      featured: form.querySelector<HTMLInputElement>('#post-featured')?.checked || false,
      pubDate: form.querySelector<HTMLInputElement>('#post-date')?.value || new Date().toISOString().slice(0, 10),
    };
  }

  function setSaving(value: boolean) {
    if (draftButton) draftButton.disabled = value;
    if (archiveButton) archiveButton.disabled = value;
    if (publishButton) publishButton.disabled = value;
  }

  function scheduleAutosave() {
    window.clearTimeout(autosaveTimer);
    if (!lifecycle.shouldAutosave((statusInput?.value || 'draft') as EditorValues['status'])) return;
    autosaveTimer = window.setTimeout(async () => {
      if (!lifecycle.shouldAutosave((statusInput?.value || 'draft') as EditorValues['status'])) return;
      const result = await save('draft', true);
      if (result && !lifecycle.dirty) setMessage('草稿已自动保存。', 'success');
    }, 10000);
  }

  async function save(statusOverride: 'draft' | 'published' | 'archived' = 'draft', silent = false) {
    if (!lifecycle.interactive) {
      if (!silent) setMessage('文章尚未加载完成。', 'error');
      return null;
    }
    if (lifecycle.isSaving) {
      if (!silent) setMessage('正在保存，请稍候。');
      return null;
    }
    const payload = {
      ...formData(statusOverride),
      ...(initial.id ? { expectedVersion: initial.version } : {}),
    };
    if (initial.id && (!Number.isSafeInteger(initial.version) || Number(initial.version) < 1)) {
      if (!silent) setMessage('文章版本无效，请重新加载页面。', 'error');
      return null;
    }
    if (!payload.title || !payload.description) { if (!silent) setMessage('请先填写标题和摘要。', 'error'); return null; }
    const savedRevision = lifecycle.beginSave();
    if (savedRevision === null) return null;
    setSaving(true);
    if (!silent) {
      setMessage(statusOverride === 'published' ? '正在发布…' : statusOverride === 'archived' ? '正在撤回…' : '正在保存…');
    }
    const token = await getCsrf();
    const endpoint = initial.id ? `/api/posts/${encodeURIComponent(initial.id)}` : '/api/posts';
    try {
      const response = await fetch(endpoint, { method: initial.id ? 'PATCH' : 'POST', credentials: 'include', headers: { 'content-type': 'application/json', ...(token ? { 'x-csrf-token': token } : {}) }, body: JSON.stringify(payload) });
      const data = await response.json().catch(() => ({})) as { id?: string; post?: { id?: string; slug?: string; version?: number }; error?: string | { message?: string }; message?: string };
      if (response.status === 401) { window.location.href = '/admin/login/'; return null; }
      const failureMessage = typeof data.error === 'string' ? data.error : data.error?.message || data.message || `保存失败（${response.status}）`;
      if (response.status === 409) {
        setMessage(`${failureMessage} 当前输入仍保留。`, 'error');
        return null;
      }
      if (!response.ok) throw new Error(failureMessage);
      lifecycle.completeSave(savedRevision);
      const savedId = data.id || data.post?.id;
      if (!initial.id && savedId) { initial.id = savedId; window.history.replaceState({}, '', `/admin/posts/${encodeURIComponent(savedId)}/`); }
      if (Number.isSafeInteger(data.post?.version)) initial.version = data.post!.version!;
      if (data.post?.slug && slugInput) slugInput.value = data.post.slug;
      if (statusInput) statusInput.value = statusOverride;
      if (statusOverride === 'published') {
        window.clearTimeout(autosaveTimer);
        publishButton?.removeAttribute('data-confirm');
        if (publishButton) publishButton.textContent = '发布文章';
        if (!silent) setMessage(lifecycle.dirty ? '当前版本已发布，刚刚输入的修改尚未保存。' : '文章已发布。', 'success');
      } else if (statusOverride === 'archived') {
        window.clearTimeout(autosaveTimer);
        if (!silent) setMessage(lifecycle.dirty ? '文章已撤回，刚刚输入的修改尚未保存。' : '文章已撤回。', 'success');
      } else {
        if (!silent) setMessage(lifecycle.dirty ? '已保存当前版本，仍有新的修改待保存。' : '草稿已保存。', 'success');
        if (lifecycle.dirty) scheduleAutosave();
      }
      return data;
    } catch (error) {
      lifecycle.failSave();
      const reason = error instanceof Error ? error.message : '保存失败，请稍后重试。';
      setMessage(silent ? `自动保存失败：${reason}` : reason, 'error');
      if (silent && lifecycle.dirty) scheduleAutosave();
      return null;
    } finally {
      if (lifecycle.isSaving) lifecycle.failSave();
      setSaving(false);
    }
  }

  form.addEventListener('input', () => {
    if (!lifecycle.markChanged()) return;
    schedulePreview();
    if (publishButton) {
      publishButton.dataset.confirm = '';
      publishButton.textContent = '发布文章';
    }
    scheduleAutosave();
  });
  draftButton?.addEventListener('click', () => save('draft'));
  archiveButton?.addEventListener('click', async () => {
    if (!initial.id || !window.confirm('确定撤回这篇文章吗？撤回后访客将无法访问。')) return;
    await save('archived');
  });
  publishButton?.addEventListener('click', async () => {
    updatePreview();
    if (publishButton.dataset.confirm !== 'true') {
      publishButton.dataset.confirm = 'true';
      publishButton.textContent = '确认发布';
      const previewTab = tabs.find((tab) => tab.dataset.editorTab === 'preview');
      previewTab?.click();
      setMessage('请检查最终预览，然后确认发布。');
      preview?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        block: 'start',
      });
      return;
    }
    await save('published');
  });
  form.querySelector<HTMLButtonElement>('[data-delete]')?.addEventListener('click', async () => {
    if (!initial.id || !window.confirm('确定删除这篇文章吗？此操作不可撤销。')) return;
    const token = await getCsrf();
    const response = await fetch(`/api/posts/${encodeURIComponent(initial.id)}`, { method: 'DELETE', credentials: 'include', headers: token ? { 'x-csrf-token': token } : {} });
    if (response.ok) window.location.href = '/admin/';
    else setMessage('删除失败，请稍后重试。', 'error');
  });
  const mobileLayout = window.matchMedia('(max-width: 760px)');
  function selectView(view = 'edit') {
    tabs.forEach((candidate) => { const active = candidate.dataset.editorTab === view; candidate.classList.toggle('is-active', active); candidate.setAttribute('aria-selected', String(active)); });
    panes.forEach((pane) => { pane.hidden = mobileLayout.matches && pane.dataset.editorPane !== view; });
  }
  tabs.forEach((tab) => tab.addEventListener('click', () => selectView(tab.dataset.editorTab)));
  const syncLayout = () => selectView(tabs.find((tab) => tab.classList.contains('is-active'))?.dataset.editorTab);
  mobileLayout.addEventListener('change', syncLayout);
  syncLayout();

  // Markdown 工具栏：所有修改都通过 input 事件驱动预览与自动保存。
  function notifyContentChanged() {
    contentInput?.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function applySurround(before: string, after: string, placeholder: string) {
    if (!contentInput) return;
    const start = contentInput.selectionStart;
    const end = contentInput.selectionEnd;
    const selected = contentInput.value.slice(start, end);
    const label = selected || placeholder;
    const text = before + label + after;
    contentInput.value = contentInput.value.slice(0, start) + text + contentInput.value.slice(end);
    notifyContentChanged();
    contentInput.focus();
    if (selected) contentInput.setSelectionRange(start, start + text.length);
    else contentInput.setSelectionRange(start + before.length, start + before.length + placeholder.length);
  }

  function applyLinePrefix(prefix: string | ((index: number) => string)) {
    if (!contentInput) return;
    const start = contentInput.selectionStart;
    const end = contentInput.selectionEnd;
    const value = contentInput.value;
    const lineStart = value.lastIndexOf('\n', start - 1) + 1;
    const nextBreak = value.indexOf('\n', end);
    const blockEnd = nextBreak === -1 ? value.length : nextBreak;
    const block = value.slice(lineStart, blockEnd);
    const prefixed = block.split('\n')
      .map((line, index) => (line.trim() ? (typeof prefix === 'function' ? prefix(index) : prefix) + line : line))
      .join('\n');
    contentInput.value = value.slice(0, lineStart) + prefixed + value.slice(blockEnd);
    notifyContentChanged();
    contentInput.focus();
    contentInput.setSelectionRange(lineStart, lineStart + prefixed.length);
  }

  function applyLink() {
    if (!contentInput) return;
    const start = contentInput.selectionStart;
    const selected = contentInput.value.slice(start, contentInput.selectionEnd);
    const label = selected || '链接文字';
    const text = `[${label}](https://)`;
    contentInput.value = contentInput.value.slice(0, start) + text + contentInput.value.slice(contentInput.selectionEnd);
    notifyContentChanged();
    contentInput.focus();
    if (selected) contentInput.setSelectionRange(start, start + text.length);
    else contentInput.setSelectionRange(start + 1, start + 1 + label.length);
  }

  function insertBlock(text: string) {
    if (!contentInput) return;
    const start = contentInput.selectionStart;
    const end = contentInput.selectionEnd;
    const needsLeadingBreak = start > 0 && contentInput.value[start - 1] !== '\n';
    const needsTrailingBreak = end < contentInput.value.length && contentInput.value[end] !== '\n';
    const block = (needsLeadingBreak ? '\n\n' : '') + text + (needsTrailingBreak ? '\n\n' : '');
    contentInput.value = contentInput.value.slice(0, start) + block + contentInput.value.slice(end);
    notifyContentChanged();
    contentInput.focus();
    contentInput.setSelectionRange(start + block.length, start + block.length);
  }

  form.querySelectorAll<HTMLButtonElement>('[data-md]').forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.dataset.md;
      if (action === 'h2') applyLinePrefix('## ');
      else if (action === 'h3') applyLinePrefix('### ');
      else if (action === 'h4') applyLinePrefix('#### ');
      else if (action === 'quote') applyLinePrefix('> ');
      else if (action === 'list') applyLinePrefix('- ');
      else if (action === 'olist') applyLinePrefix((index) => `${index + 1}. `);
      else if (action === 'bold') applySurround('**', '**', '粗体文字');
      else if (action === 'italic') applySurround('*', '*', '斜体文字');
      else if (action === 'strike') applySurround('~~', '~~', '删除文字');
      else if (action === 'code') applySurround('`', '`', '代码');
      else if (action === 'codeblock') applySurround('\n```\n', '\n```\n', '代码块');
      else if (action === 'link') applyLink();
      else if (action === 'hr') insertBlock('---');
      else if (action === 'table') insertBlock('| 表头一 | 表头二 | 表头三 |\n| --- | --- | --- |\n| 内容 | 内容 | 内容 |');
    });
  });

  contentInput?.addEventListener('keydown', (event) => {
    if (!(event.ctrlKey || event.metaKey) || event.altKey || event.shiftKey) return;
    const key = event.key.toLowerCase();
    if (key === 'b') { event.preventDefault(); applySurround('**', '**', '粗体文字'); }
    else if (key === 'i') { event.preventDefault(); applySurround('*', '*', '斜体文字'); }
    else if (key === 'k') { event.preventDefault(); applyLink(); }
  });

  // 图片上传：粘贴、拖拽与按钮三个通道共用同一逻辑。
  let uploadSeq = 0;

  function replaceMarker(marker: string, replacement: string) {
    if (!contentInput) return;
    const index = contentInput.value.indexOf(marker);
    if (index === -1) return;
    contentInput.value = contentInput.value.slice(0, index) + replacement + contentInput.value.slice(index + marker.length);
    notifyContentChanged();
  }

  async function uploadImage(file: File) {
    if (!contentInput) return;
    if (file.size > 5 * 1024 * 1024) { setMessage('图片不能超过 5MB。', 'error'); return; }
    const marker = `![上传中…](uploading-${++uploadSeq})`;
    insertBlock(marker);
    setMessage('正在上传图片…');
    try {
      const token = await getCsrf();
      const body = new FormData();
      body.append('file', file);
      const response = await fetch('/api/images', {
        method: 'POST',
        credentials: 'include',
        headers: token ? { 'x-csrf-token': token } : {},
        body,
      });
      const data = await response.json().catch(() => ({})) as { url?: string; error?: string };
      if (response.status === 401) { window.location.href = '/admin/login/'; return; }
      if (!response.ok || !data.url) throw new Error(data.error || `上传失败（${response.status}）`);
      const alt = file.name.replace(/\.[a-z0-9]+$/i, '').slice(0, 60) || '图片';
      replaceMarker(marker, `![${alt}](${data.url})`);
      setMessage('图片已上传。', 'success');
    } catch (error) {
      replaceMarker(marker, '');
      setMessage(error instanceof Error ? error.message : '图片上传失败，请稍后重试。', 'error');
    }
  }

  function uploadFiles(files: Iterable<File>) {
    Array.from(files).filter((file) => file.type.startsWith('image/')).forEach((file) => { void uploadImage(file); });
  }

  const fileInput = form.querySelector<HTMLInputElement>('[data-md-file]');
  form.querySelector<HTMLButtonElement>('[data-md-image]')?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => {
    uploadFiles(fileInput.files ?? []);
    fileInput.value = '';
  });
  contentInput?.addEventListener('paste', (event) => {
    const files = Array.from(event.clipboardData?.files ?? []).filter((file) => file.type.startsWith('image/'));
    if (!files.length) return;
    event.preventDefault();
    uploadFiles(files);
  });
  contentInput?.addEventListener('dragover', (event) => event.preventDefault());
  contentInput?.addEventListener('drop', (event) => {
    const files = Array.from(event.dataTransfer?.files ?? []).filter((file) => file.type.startsWith('image/'));
    if (!files.length) return;
    event.preventDefault();
    uploadFiles(files);
  });

  // 图片库：查看 / 复制链接 / 从存储中永久删除已上传的图片。
  const gallery = form.querySelector<HTMLDialogElement>('[data-gallery]');
  const galleryGrid = form.querySelector<HTMLElement>('[data-gallery-grid]');
  const galleryEmpty = form.querySelector<HTMLElement>('[data-gallery-empty]');

  function galleryCard(entry: { key: string }) {
    const card = document.createElement('div');
    card.className = 'gallery-card';
    const image = document.createElement('img');
    image.src = `/images/${entry.key}`;
    image.alt = '';
    image.loading = 'lazy';
    const name = document.createElement('code');
    name.className = 'gallery-key';
    name.textContent = entry.key.length > 34 ? `${entry.key.slice(0, 16)}…${entry.key.slice(-14)}` : entry.key;
    name.title = entry.key;
    const row = document.createElement('div');
    row.className = 'gallery-actions';
    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'button button--secondary';
    copy.textContent = '复制链接';
    copy.addEventListener('click', () => {
      void navigator.clipboard?.writeText(`${window.location.origin}/images/${entry.key}`);
      copy.textContent = '已复制';
      window.setTimeout(() => { copy.textContent = '复制链接'; }, 1200);
    });
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'button button--secondary gallery-delete';
    remove.textContent = '删除';
    remove.addEventListener('click', async () => {
      if (!window.confirm('确定从存储中永久删除这张图片吗？引用它的文章将无法显示，操作不可恢复。')) return;
      remove.disabled = true;
      try {
        const token = await getCsrf();
        const response = await fetch(`/api/images/${encodeURIComponent(entry.key)}`, {
          method: 'DELETE',
          credentials: 'include',
          headers: token ? { 'x-csrf-token': token } : {},
        });
        const data = await response.json().catch(() => ({})) as { error?: string };
        if (response.status === 401) { window.location.href = '/admin/login/'; return; }
        if (!response.ok) throw new Error(data.error || `删除失败（${response.status}）`);
        card.remove();
        if (galleryGrid && !galleryGrid.querySelector('.gallery-card')) galleryEmpty?.removeAttribute('hidden');
        setMessage('图片已删除。', 'success');
      } catch (error) {
        remove.disabled = false;
        setMessage(error instanceof Error ? error.message : '删除失败，请稍后重试。', 'error');
      }
    });
    row.appendChild(copy);
    row.appendChild(remove);
    card.appendChild(image);
    card.appendChild(name);
    card.appendChild(row);
    return card;
  }

  form.querySelector<HTMLButtonElement>('[data-md-gallery]')?.addEventListener('click', async () => {
    if (!gallery) return;
    gallery.showModal();
    if (galleryGrid) galleryGrid.replaceChildren();
    galleryEmpty?.setAttribute('hidden', '');
    setMessage('正在加载图片库…');
    try {
      const response = await fetch('/api/images', { credentials: 'include' });
      const data = await response.json().catch(() => ({})) as { images?: Array<{ key: string }>; error?: string };
      if (response.status === 401) { window.location.href = '/admin/login/'; return; }
      if (!response.ok) throw new Error(data.error || `读取图片库失败（${response.status}）`);
      const images = data.images ?? [];
      if (galleryGrid) for (const entry of images) galleryGrid.appendChild(galleryCard(entry));
      if (!images.length) galleryEmpty?.removeAttribute('hidden');
      setMessage('');
    } catch (error) {
      setMessage(error instanceof Error ? error.message : '读取图片库失败。', 'error');
    }
  });
  gallery?.querySelector('[data-gallery-close]')?.addEventListener('click', () => gallery.close());
  gallery?.addEventListener('click', (event) => { if (event.target === gallery) gallery.close(); });
</script>

<style>
  .editor-shell { width: min(100%, 1120px); margin-inline: auto; }
  .editor-toolbar { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
  .editor-toolbar .page-title { margin: 0; }
  .editor-actions { justify-content: end; }
  .editor-message { min-height: 1.7em; margin-bottom: 12px; color: var(--text-muted); font-size: 0.9rem; }
