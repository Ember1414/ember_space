  .editor-message[data-kind='success'] { color: var(--success); }
  .editor-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 20px; padding: 22px; margin-bottom: 22px; }
  .field { display: flex; min-width: 0; flex-direction: column; gap: 6px; }
  .field--wide { grid-column: 1 / -1; }
  .field label { color: var(--text-soft); font-size: 0.82rem; font-weight: 750; }
  .field label span { color: var(--accent); }
  .field input, .field textarea, .field select { width: 100%; padding: 0.65rem 0.72rem; border: 1px solid var(--border-strong); border-radius: 4px; background: var(--surface); color: var(--text); }
  .field textarea { min-height: 74px; resize: vertical; }
  .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--focus); outline: 2px solid color-mix(in srgb, var(--focus) 30%, transparent); }
  .field small { color: var(--text-muted); font-size: 0.74rem; }
  .field-checks { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 8px; }
  .check-label { display: flex; min-height: 42px; align-items: center; gap: 8px; }
  .check-label input { width: 18px; height: 18px; }
  .editor-tabs { display: none; gap: 4px; margin-bottom: 10px; border-bottom: 1px solid var(--border); }
  .editor-tab { min-height: 42px; padding: 0 16px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--text-muted); font-weight: 750; cursor: pointer; }
  .editor-tab.is-active { border-bottom-color: var(--accent); color: var(--text); }
  .editor-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .editor-pane { min-width: 0; min-height: 520px; overflow: hidden; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); }
  .editor-pane--write { display: flex; flex-direction: column; }
  .md-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 2px; padding: 6px 8px; border-bottom: 1px solid var(--border); }
  .md-tool { min-width: 30px; min-height: 30px; padding: 0 7px; border: 0; border-radius: 4px; background: transparent; color: var(--text-soft); font: 700 0.78rem/1 var(--font-mono); cursor: pointer; }
  .md-tool:hover { background: color-mix(in srgb, var(--border) 60%, transparent); color: var(--text); }
  .md-tool:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .md-sep { width: 1px; height: 18px; margin: 0 4px; background: var(--border); }
  .editor-pane--write .markdown-input { flex: 1; min-height: 472px; }
  .markdown-input { display: block; width: 100%; height: 100%; min-height: 520px; padding: 20px; border: 0; outline: 0; resize: vertical; background: transparent; color: var(--text); font: 0.9rem/1.75 var(--font-mono); }
  .preview-content { min-height: 520px; padding: 20px; }
  .preview-placeholder { color: var(--text-muted); }
  .danger-link { margin-top: 24px; padding: 0; border: 0; background: transparent; color: var(--accent-strong); font-size: 0.84rem; font-weight: 700; cursor: pointer; }
  .danger-link:hover { text-decoration: underline; }
  .danger-link[hidden], .field option[hidden], .editor-pane[hidden] { display: none; }
  .autosave-hint { margin: 10px 0 0; color: var(--text-muted); font-size: 0.78rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .gallery-dialog {
    width: min(760px, calc(100% - 24px)); max-height: min(80dvh, 640px); padding: 20px;
    border: 1px solid var(--border-strong); border-radius: 7px; background: var(--surface); color: var(--text);
  }
  .gallery-dialog::backdrop { background: rgb(0 0 0 / 55%); backdrop-filter: blur(3px); }
  .gallery-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .gallery-head strong { font-size: 1.1rem; }
  .gallery-hint { margin: 0 0 14px; color: var(--text-muted); font-size: 0.8rem; }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; overflow-y: auto; }
  .gallery-card { display: grid; gap: 8px; padding: 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--surface-soft); }
  .gallery-card img { width: 100%; height: 100px; border-radius: 4px; object-fit: cover; background: var(--surface); }
  .gallery-key { overflow: hidden; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.68rem; text-overflow: ellipsis; white-space: nowrap; }
  .gallery-actions { display: flex; gap: 6px; }
  .gallery-actions .button { flex: 1; min-height: 34px; padding-inline: 8px; font-size: 0.76rem; }
  .gallery-delete { color: var(--accent-strong); }
  .gallery-empty { margin: 18px 0 0; color: var(--text-muted); font-size: 0.88rem; }
  @media (max-width: 760px) {
    .editor-toolbar { align-items: start; flex-direction: column; }
    .editor-actions { width: 100%; justify-content: start; }
    .editor-actions .button { flex: 1; }
    .editor-fields { grid-template-columns: 1fr; padding: 16px; }
    .field--wide { grid-column: auto; }
    .field-checks { grid-template-columns: 1fr; }
    .editor-tabs { display: flex; }
    .editor-grid { display: block; }
    .editor-pane { min-height: 420px; }
    .editor-pane--preview { margin-top: 0; }
    .markdown-input, .preview-content { min-height: 420px; }
  }
</style>
