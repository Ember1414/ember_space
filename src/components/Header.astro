---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const path = Astro.url.pathname;
// 语言切换：/xxx ↔ /en/xxx
const langSwitchHref =
  lang === 'zh' ? `/en${path === '/' ? '/' : path}` : path.replace('/en', '') || '/';
const langSwitchLabel = lang === 'zh' ? 'EN' : '中';
---

<header class="site-header">
  <div class="header-inner">
    <a href={lang === 'zh' ? '/' : '/en/'} class="logo" aria-label="Home">
      <span class="path">~</span>/<span class="bin">ember</span><span class="path"> $</span>
    </a>
    <nav class="nav" aria-label="Utility">
      <span class="header-clock" data-clock title={lang === 'zh' ? '北京时间' : 'Beijing Time (UTC+8)'}>--:--:--</span>
      <a class="lang-btn" href={langSwitchHref} aria-label="Switch language">{langSwitchLabel}</a>
      <button class="theme-btn js-theme-toggle" type="button" title={t(lang, 'theme.toggle')}>
        <span class="js-theme-icon">☀︎</span>
      </button>
      <button class="theme-btn js-menu-open" type="button" aria-label={t(lang, 'menu.open')}>
        <Icon name="menu" size={16} />
      </button>
    </nav>
  </div>
</header>
