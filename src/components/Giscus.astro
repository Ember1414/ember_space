---
import { GISCUS } from '../consts';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const configured = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.categoryId);
---

<div class="comments">
  <p class="prompt" style="font-size: 0.88rem; margin: 0 0 1rem;">{t(lang, 'post.comments')}</p>
  {configured ? (
    <div id="giscus-container"></div>
  ) : (
    <div class="comments-hint">
      {t(lang, 'giscus.notConfigured')}
      <code>src/consts.ts</code> — <a href="https://giscus.app" target="_blank" rel="noopener">giscus.app</a>{t(lang, 'giscus.notConfiguredTail')}
    </div>
  )}
</div>

{configured && (
  <script is:inline define:vars={{ GISCUS, lang }}>
    (function () {
      var container = document.getElementById('giscus-container');
      var giscusOrigin = 'https://giscus.app';
      var giscusReady = false;

      function currentGiscusTheme() {
        return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark_dimmed';
      }

      function getGiscusFrame() {
        return container && container.querySelector('iframe.giscus-frame');
      }

      function syncGiscusTheme() {
        var iframe = getGiscusFrame();
        if (!iframe || !iframe.contentWindow) return;

        iframe.contentWindow.postMessage(
          { giscus: { setConfig: { theme: currentGiscusTheme() } } },
          giscusOrigin
        );
      }

      // A lazy-loaded Giscus iframe may not be ready when the site theme changes.
      // Its first resize event confirms that its message listener has mounted, so
      // replay the latest theme once instead of leaving it on its initial theme.
      window.addEventListener('message', function (event) {
        var data = event.data;
        var giscus = data && typeof data === 'object' ? data.giscus : null;
        var iframe = getGiscusFrame();
        if (
          giscusReady ||
          event.origin !== giscusOrigin ||
          !giscus ||
          typeof giscus !== 'object' ||
          !Object.prototype.hasOwnProperty.call(giscus, 'resizeHeight') ||
          !iframe ||
          event.source !== iframe.contentWindow
        ) {
          return;
        }

        giscusReady = true;
        syncGiscusTheme();
      });

      var s = document.createElement('script');
      var cfg = {
        src: 'https://giscus.app/client.js',
        'data-repo': GISCUS.repo,
        'data-repo-id': GISCUS.repoId,
        'data-category': GISCUS.category,
        'data-category-id': GISCUS.categoryId,
        'data-mapping': GISCUS.mapping || 'pathname',
        'data-strict': '0',
        'data-reactions-enabled': GISCUS.reactionsEnabled || '1',
        'data-emit-metadata': '0',
        'data-input-position': 'top',
        'data-theme': document.documentElement.dataset.theme === 'light' ? 'light' : 'dark_dimmed',
        'data-lang': lang === 'zh' ? 'zh-CN' : 'en',
        'data-loading': 'lazy',
        crossorigin: 'anonymous',
        async: '',
      };
      for (var k in cfg) s.setAttribute(k, cfg[k]);
      container.appendChild(s);

      document.addEventListener('ember:theme', syncGiscusTheme);
    })();
  </script>
)}
