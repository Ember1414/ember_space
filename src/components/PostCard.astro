---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  post: CollectionEntry<'posts'>;
  lang?: Lang;
  headingLevel?: 2 | 3;
}

const { post, lang = 'zh', headingLevel = 3 } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const date = post.data.pubDate.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.round((post.body?.replace(/\s/g, '').length ?? 0) / 400));
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<li class="post-item">
  <time class="post-item-date" datetime={date}>{date}</time>
  <div>
    <Heading class="post-item-title">
      <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
    </Heading>
    <p class="post-item-desc">{post.data.description}</p>
  </div>
  <div class="post-item-meta post-item-meta--stacked">
    <span>{lang === 'zh' ? `约 ${minutes} 分钟` : `${minutes} min`}</span>
    {post.data.tags.slice(0, 2).map((tag) => <a class="tag" href={`${base}/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
  </div>
</li>
