---
import { ArrowLeft, FileText, FolderKanban, Search } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const alternatePath = lang === 'zh' ? '/en/404/' : '/404/';
---

<BaseLayout
  lang={lang}
  title={t(lang, 'notFound.title')}
  description={t(lang, 'notFound.text')}
  canonicalPath={`${base}/404/`}
  alternatePath={alternatePath}
  noindex
>
  <section class="not-found shell" data-pagefind-ignore>
    <div class="not-found-code" aria-hidden="true">404</div>
    <div class="not-found-copy">
      <p class="eyebrow">{t(lang, 'notFound.eyebrow')}</p>
      <h1>{t(lang, 'notFound.title')}</h1>
      <p>{t(lang, 'notFound.text')}</p>
      <nav class="not-found-links" aria-label={t(lang, 'a11y.primaryNav')}>
        <a class="button button--primary" href={base || '/'}>
          <ArrowLeft size={18} aria-hidden="true" />
          {t(lang, 'notFound.home')}
        </a>
        <a class="not-found-link" href={`${base}/posts/`}>
          <FileText size={18} aria-hidden="true" />
          {t(lang, 'notFound.posts')}
        </a>
        <a class="not-found-link" href={`${base}/projects/`}>
          <FolderKanban size={18} aria-hidden="true" />
          {t(lang, 'notFound.projects')}
        </a>
        <a class="not-found-link" href={`${base}/search/`}>
          <Search size={18} aria-hidden="true" />
          {t(lang, 'notFound.search')}
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100svh - var(--header-height) - 250px);
    padding-block: 72px 96px;
    grid-template-columns: minmax(180px, 0.7fr) minmax(0, 1.3fr);
    align-items: center;
    gap: 64px;
  }

  .not-found-code {
    color: color-mix(in srgb, var(--accent) 24%, var(--border));
    font-family: var(--font-mono);
    font-size: 8rem;
    font-weight: 800;
    line-height: 0.8;
  }

  .not-found-copy {
    max-width: 620px;
  }

  .not-found-copy h1 {
    margin: 0.35rem 0 1rem;
    font-family: var(--font-serif);
    font-size: 2.75rem;
  }

  .not-found-copy > p:not(.eyebrow) {
    max-width: 50ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .not-found-links {
    display: flex;
    margin-top: 32px;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
  }

  .not-found-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
    font-weight: 700;
    text-decoration: none;
  }

  .not-found-link:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .not-found {
      min-height: auto;
      padding-block: 56px 72px;
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .not-found-code {
      font-size: 5.5rem;
    }

    .not-found-copy h1 {
      font-size: 2.15rem;
    }
  }
</style>
