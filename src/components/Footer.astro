---
import { SITE } from '../consts';
import { t, tf, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const year = new Date().getFullYear();

// 订阅表单消息传给内联脚本
const msgs = {
  sending: t(lang, 'footer.sending'),
  ok: t(lang, 'footer.ok'),
  duplicate: t(lang, 'footer.duplicate'),
  invalid: t(lang, 'footer.invalid'),
  serverError: t(lang, 'footer.serverError'),
  networkError: t(lang, 'footer.networkError'),
  fallbackError: t(lang, 'footer.fallbackError'),
};
---

<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <p class="prompt" style="font-size: 0.88rem; margin: 0 0 0.8rem;">{t(lang, 'footer.subscribe')}</p>
      <form class="subscribe" id="subscribe-form">
        <input type="email" name="email" required placeholder={t(lang, 'footer.placeholder')} aria-label="Email" />
        <button class="btn" type="submit">{t(lang, 'footer.subscribeBtn')}</button>
        <p class="form-msg" id="subscribe-msg" role="status" aria-live="polite"></p>
      </form>
    </div>
    <div class="footer-meta">
      <span>{t(lang, 'footer.copyright')(SITE.author, year)} <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> &amp; <a href="https://pages.cloudflare.com" target="_blank" rel="noopener">Cloudflare Pages</a></span>
      <span>
        <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
        ·
        <a href={SITE.social.email}>Email</a>
        ·
        <a href="/rss.xml">RSS</a>
      </span>
    </div>
  </div>
</footer>

<script define:vars={{ msgs, lang }}>
  const form = document.getElementById('subscribe-form');
  const msg = document.getElementById('subscribe-msg');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const email = (new FormData(form).get('email') || '').trim();
    msg.className = 'form-msg';
    msg.textContent = msgs.sending;
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      msg.className = 'form-msg ' + (res.ok ? 'ok' : 'err');
      if (res.status === 400) msg.textContent = msgs.invalid;
      else if (res.ok && data.duplicate) msg.textContent = msgs.duplicate;
      else if (res.ok) { msg.textContent = msgs.ok; form.reset(); }
      else msg.textContent = data.error || msgs.fallbackError;
    } catch {
      msg.className = 'form-msg err';
      msg.textContent = msgs.networkError;
    }
  });
</script>
