---
import { Github, Mail, Rss } from 'lucide-astro';
import { SITE } from '../consts';
import { t, tf, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  cta?: boolean;
}

const { lang = 'zh', cta = false } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {cta && (
    <div class="footer-cta shell">
      <div>
        <p class="eyebrow">RSS / XML</p>
        <h2>{t(lang, 'footer.rssTitle')}</h2>
        <p>{t(lang, 'footer.rssText')}</p>
      </div>
      <a class="button button--primary" href={`${base}/rss/`} aria-label={t(lang, 'a11y.rss')}>
        <Rss size={18} aria-hidden="true" />
        {t(lang, 'footer.rssButton')}
      </a>
    </div>
  )}

  <div class="footer-bottom">
    <div class="footer-bottom-inner shell">
      <p>{tf(lang, 'footer.copyright', SITE.author, year)} · Built with Astro</p>
      <nav aria-label={t(lang, 'a11y.utilityNav')}>
        <a href={SITE.social.github} target="_blank" rel="noopener" aria-label={t(lang, 'a11y.github')} title="GitHub">
          <Github size={18} aria-hidden="true" />
        </a>
        <a href={SITE.social.email} aria-label={t(lang, 'a11y.email')} title="Email">
          <Mail size={18} aria-hidden="true" />
        </a>
        <a href={`${base}/rss/`} aria-label={t(lang, 'a11y.rss')} title="RSS">
          <Rss size={18} aria-hidden="true" />
        </a>
        <a href={`${base}/about/`}>{t(lang, 'nav.about')}</a>
        <a href={`${base}/account/`}>{t(lang, 'nav.account')}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-block: 48px;
  }

  .footer-cta h2 {
    margin: 0;
    font-size: 1.65rem;
  }

  .footer-cta p:not(.eyebrow) {
    max-width: 58ch;
    margin: 0.55rem 0 0;
    color: var(--text-muted);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    background: var(--surface-soft);
  }

  .footer-bottom-inner {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .footer-bottom-inner p {
    margin: 0;
  }

  .footer-bottom nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .footer-bottom nav a {
    display: inline-flex;
    min-width: 40px;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }

  .footer-bottom nav a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .footer-cta,
    .footer-bottom-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-cta {
      padding-block: 40px;
    }

    .footer-bottom-inner {
      padding-block: 18px;
    }
  }
</style>
