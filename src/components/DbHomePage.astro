---
import { ArrowRight } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import DbPostCard from './DbPostCard.astro';
import ProjectCard from './ProjectCard.astro';
import type { PostSummary } from '../lib/db';
import { SITE } from '../consts';
import type { Lang } from '../i18n/ui';
import { t, tf } from '../i18n/ui';
import { getCollection } from 'astro:content';
import { repositoryUrlKey } from '../lib/repoUrl';
import reposCache from '../data/github-repos.json';
import '../styles/pages/home.css';

interface Props { lang: Lang; posts: PostSummary[]; }
const { lang, posts } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const projects = (await getCollection('projects', ({ data }) => data.lang === lang)).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const latest = posts.filter((post) => post.slug !== featuredPost?.slug).slice(0, 4);
const featuredProject = projects.find(({ data }) => data.featured) ?? projects[0];
const emptyText = lang === 'zh' ? '这里会展示经过整理的工程笔记与实践记录。' : 'No published English post is available yet.';
const tagCount = new Set(posts.flatMap((post) => post.tags)).size;
const establishedMs = Date.parse(SITE.established);
const siteDays = Number.isFinite(establishedMs) ? Math.max(1, Math.floor((Date.now() - establishedMs) / 86_400_000) + 1) : 0;
// 收录项目数 = 项目页实际展示数：GitHub 仓库（构建期缓存）+ 未被仓库覆盖的策划条目，按仓库地址去重
const repoKeys = new Set(
  reposCache.map((repo) => repositoryUrlKey(repo.html_url) ?? '').filter(Boolean),
);
const curatedOnly = projects.filter((project) => {
  const key = repositoryUrlKey(project.data.repo) ?? '';
  return !key || !repoKeys.has(key);
}).length;
const projectTotal = repoKeys.size + curatedOnly;
const stats = [
  { value: String(posts.length), label: lang === 'zh' ? '已发布文章' : 'Posts published' },
  { value: String(tagCount), label: lang === 'zh' ? '主题标签' : 'Topics' },
  { value: String(projectTotal), label: lang === 'zh' ? '收录项目' : 'Projects' },
  ...(siteDays ? [{ value: String(siteDays), label: lang === 'zh' ? '建站天数' : 'Days online' }] : []),
];
---
<BaseLayout lang={lang} wide footerCta canonicalPath={lang === 'zh' ? '/' : '/en/'} alternatePath={lang === 'zh' ? '/en/' : '/'}>
  <div class="home-page" data-pagefind-filter={`lang:${lang}`}><Hero lang={lang} /><section class="section-band home-stats-band" aria-label={lang === 'zh' ? '站点数据' : 'Site stats'}><div class="shell home-stats anim">{stats.map(({ value, label }) => <div class="stat"><span class="stat-num">{value}</span><span class="stat-label">{label}</span></div>)}</div></section><section class="section-band home-focus"><div class="shell"><header class="section-head anim"><div><p class="eyebrow">ISSUE 01 / EDITOR'S PICK</p><h2>{t(lang, 'home.featured')}</h2><p>{t(lang, 'home.featuredIntro')}</p></div></header><div class="feature-grid"><div>{featuredPost ? <article class="card feature-post anim"><div class="card-body"><p class="feature-label">{t(lang, 'home.featuredPost')}</p><h3><a href={`${base}/posts/${featuredPost.slug}/`}>{featuredPost.title}</a></h3><p>{featuredPost.description}</p><div class="feature-meta"><time datetime={featuredPost.pubDate}>{featuredPost.pubDate.slice(0, 10)}</time><span>{tf(lang, 'post.min', Math.max(1, Math.round(featuredPost.bodyLength / 400)))}</span></div><ul class="tag-list">{featuredPost.tags.slice(0, 3).map((tag) => <li><a class="tag" href={`${base}/tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>)}</ul><a class="feature-link" href={`${base}/posts/${featuredPost.slug}/`}>{t(lang, 'home.readPosts')} <ArrowRight size={16} aria-hidden="true" /></a></div></article> : <article class="empty-state home-empty"><h3>{lang === 'zh' ? '文章正在整理中' : 'English writing is in progress'}</h3><p>{emptyText}</p></article>}</div><div class="featured-project anim">{featuredProject ? <ProjectCard project={featuredProject} lang={lang} /> : <article class="empty-state home-empty"><h3>{lang === 'zh' ? '项目正在整理中' : 'English projects are in progress'}</h3></article>}</div></div></div></section><section class="section-band section-band--soft"><div class="shell anim"><header class="section-head"><div><p class="eyebrow">RECENT NOTES</p><h2>{t(lang, 'home.latest')}</h2></div><a class="section-link" href={`${base}/posts/`}>{t(lang, 'home.viewAll')} <span aria-hidden="true">→</span></a></header>{latest.length > 0 ? <ol class="post-list home-recent">{latest.map((post) => <DbPostCard post={post} lang={lang} headingLevel={3} />)}</ol> : <div class="empty-state"><h3>{lang === 'zh' ? '文章正在整理中' : 'English writing is in progress'}</h3><p>{emptyText}</p></div>}</div></section></div>
</BaseLayout>
