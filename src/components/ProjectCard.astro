---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight, Github, Star } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '../i18n/ui';
import { formatRepositoryDate } from '../lib/github';

interface Props {
  project: CollectionEntry<'projects'>;
  lang?: Lang;
  updatedAt?: string | null;
  stars?: number;
}

const { project, lang = 'zh', updatedAt = null, stars } = Astro.props;
const data = project.data;
const base = lang === 'en' ? '/en' : '';
const detailHref = `${base}/projects/${project.id}/`;
const updatedDate = formatRepositoryDate(updatedAt);
const dateLabel = updatedDate ?? String(data.year);
---

<article class="card project-card">
  {data.image ? (
    <div class="card-media">
      <Image src={data.image} alt={data.imageAlt ?? ''} widths={[480, 760]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" />
    </div>
  ) : (
    <div class="card-media project-fallback">
      <span class="project-fallback-date">
        <small>{updatedDate ? (lang === 'zh' ? '更新于' : 'Updated') : (lang === 'zh' ? '年份' : 'Year')}</small>
        {updatedAt && updatedDate ? <time datetime={updatedAt}>{dateLabel}</time> : <span>{dateLabel}</span>}
      </span>
      <span aria-hidden="true">{data.tags[0] ?? 'BUILD'}</span>
    </div>
  )}
  <div class="card-body">
    <div class="project-kicker">
      <span>{data.status ?? data.year}</span>
      {data.role && <span>{data.role}</span>}
      {typeof stars === 'number' && <span class="project-stars"><Star size={13} aria-hidden="true" /> {stars}</span>}
    </div>
    <h3><a href={detailHref}>{data.name}</a></h3>
    <p>{data.description}</p>
    {data.highlights.length > 0 && (
      <ul class="highlights">
        {data.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
      </ul>
    )}
    <ul class="tag-list">
      {data.tags.map((tag) => <li><span class="tag">{tag}</span></li>)}
    </ul>
    <div class="project-links">
      <a href={detailHref}>{t(lang, 'projects.caseStudy')} <ArrowRight size={15} aria-hidden="true" /></a>
      {data.url && <a href={data.url} target="_blank" rel="noopener">{t(lang, 'projects.visit')} <ArrowUpRight size={15} aria-hidden="true" /></a>}
      {data.repo && <a href={data.repo} target="_blank" rel="noopener"><Github size={15} aria-hidden="true" /> {t(lang, 'projects.source')}</a>}
    </div>
  </div>
</article>

<style>
  .project-fallback {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 24px;
    background:
      linear-gradient(90deg, transparent 49.8%, color-mix(in srgb, var(--border) 80%, transparent) 50%, transparent 50.2%),
      linear-gradient(0deg, transparent 49.8%, color-mix(in srgb, var(--border) 80%, transparent) 50%, transparent 50.2%),
      var(--surface-soft);
    background-size: 42px 42px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .project-fallback-date {
    display: grid;
    gap: 4px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .project-fallback-date small {
    color: var(--text-muted);
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .project-stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .highlights {
    margin: 0 0 18px;
    padding-left: 1.2rem;
    color: var(--text-soft);
    font-size: 0.88rem;
  }

  .highlights li + li {
    margin-top: 0.35rem;
  }

  .highlights li::marker {
    color: var(--accent);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 20px;
  }

  .project-card {
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  .project-card .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .project-card .project-links {
    margin-top: auto;
    padding-top: 20px;
  }

  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    font-weight: 700;
  }
</style>
