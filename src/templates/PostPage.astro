---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Giscus from '../components/Giscus.astro';
import { t, tf, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  post: CollectionEntry<'posts'>;
}

const { lang, post } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const { Content, headings } = await render(post);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
const readMinutes = Math.max(1, Math.round((post.body?.replace(/\s/g, '').length ?? 0) / 400));

// 构建两级目录（h2/h3）
interface TocItem {
  slug: string;
  text: string;
  children: { slug: string; text: string }[];
}
const toc: TocItem[] = [];
for (const h of headings) {
  if (h.depth === 2) {
    toc.push({ slug: h.slug, text: h.text, children: [] });
  } else if (h.depth === 3 && toc.length > 0) {
    toc[toc.length - 1].children.push({ slug: h.slug, text: h.text });
  }
}

// 上一篇 / 下一篇（同语言内按时间）
const siblings = (await getCollection('posts', ({ data }) => !data.draft && data.lang === post.data.lang))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const idx = siblings.findIndex((p) => p.id === post.id);
const newer = idx < siblings.length - 1 ? siblings[idx + 1] : null;
const older = idx > 0 ? siblings[idx - 1] : null;
---

<div class="post-layout">
  <article>
    {lang === 'en' && post.data.lang !== 'en' && (
      <p class="comments-hint anim" style="margin: 0 0 1.5rem;">{t(lang, 'post.noEnglish')}</p>
    )}

    <header class="post-header anim">
      <p class="prompt" style="margin: 0; font-size: 0.85rem;">cat ./posts/{post.id}.md</p>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={fmt(post.data.pubDate)}>📅 {fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && <time datetime={fmt(post.data.updatedDate)}>{tf(lang, 'post.updated', fmt(post.data.updatedDate))}</time>}
        <span>{tf(lang, 'post.min', readMinutes)}</span>
        <span class="views" data-views data-path={`${base}/posts/${post.id}/`}>👀 <span class="views-num">···</span></span>
      </div>
      <div class="post-item-meta" style="margin-top: 0.7rem;">
        {post.data.tags.map((tg) => <a class="tag" href={`${base}/tags/${tg}/`}>#{tg}</a>)}
      </div>
    </header>

    <div class="prose anim" style="animation-delay: 0.12s;" data-pagefind-body={lang === 'zh' ? true : undefined} data-pagefind-meta={lang === 'zh' ? 'type:文章' : undefined}>
      <Content />
    </div>

    <nav class="post-nav">
      {older ? <a href={`${base}/posts/${older.id}/`}>{tf(lang, 'post.prev', older.data.title)}</a> : <span></span>}
      {newer && <a href={`${base}/posts/${newer.id}/`}>{tf(lang, 'post.next', newer.data.title)}</a>}
    </nav>

    <Giscus lang={lang} />
  </article>

  {toc.length > 0 && (
    <aside class="toc" aria-label={t(lang, 'post.toc')}>
      <div class="toc-inner">
        <p class="toc-title">{t(lang, 'post.toc')}</p>
        <ul>
          {toc.map((h2) => (
            <li>
              <a href={`#${h2.slug}`}>{h2.text}</a>
              {h2.children.length > 0 && (
                <ul>
                  {h2.children.map((h3) => <li><a href={`#${h3.slug}`}>{h3.text}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )}
</div>

<script>
  // 浏览量：页面打开即 +1（中英文路由共享计数），API 不可用时隐藏
  (function () {
    var el = document.querySelector('[data-views]');
    if (!el) return;
    var num = el.querySelector('.views-num');
    fetch('/api/views', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: el.getAttribute('data-path') }),
    })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (typeof d.views === 'number' && num) num.textContent = String(d.views);
        else el.style.display = 'none';
      })
      .catch(function () { el.style.display = 'none'; });
  })();
</script>

<script>
  // 目录跟随滚动：高亮当前所在章节，并让目录自动滚动到当前项
  (function () {
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
    const headings = tocLinks
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null);

    if (headings.length === 0) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const fromTop = window.scrollY + 130;
      let current = headings[0];
      for (const h of headings) {
        if (h.offsetTop <= fromTop) current = h;
      }
      let activeLink: HTMLAnchorElement | undefined;
      tocLinks.forEach((a) => {
        const on = decodeURIComponent(a.hash.slice(1)) === current.id;
        a.classList.toggle('active', on);
        if (on) activeLink = a;
      });
      activeLink?.scrollIntoView({ block: 'nearest' });
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    update();
  })();
</script>
