---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, Check, CircleX, Copy } from 'lucide-astro';
import Giscus from '../components/Giscus.astro';
import { t, tf, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  post: CollectionEntry<'posts'>;
}

interface TocItem {
  slug: string;
  text: string;
  children: Array<{ slug: string; text: string }>;
}

const { lang, post } = Astro.props;
const base = lang === 'en' ? '/en' : '';
const { Content, headings } = await render(post);
const fmt = (date: Date) => date.toISOString().slice(0, 10);
const readMinutes = Math.max(1, Math.round((post.body?.replace(/\s/g, '').length ?? 0) / 400));

const toc: TocItem[] = [];
for (const heading of headings) {
  if (heading.depth === 2) {
    toc.push({ slug: heading.slug, text: heading.text, children: [] });
  } else if (heading.depth === 3 && toc.length > 0) {
    toc[toc.length - 1].children.push({ slug: heading.slug, text: heading.text });
  }
}

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang)).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);
const currentIndex = posts.findIndex((candidate) => candidate.id === post.id);
const older = currentIndex > 0 ? posts[currentIndex - 1] : null;
const newer = currentIndex >= 0 && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : null;
const currentTags = new Set(post.data.tags);
const related = posts
  .filter((candidate) => candidate.id !== post.id)
  .map((candidate) => ({
    post: candidate,
    score: candidate.data.tags.reduce((total, tag) => total + (currentTags.has(tag) ? 1 : 0), 0),
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map(({ post: candidate }) => candidate);
---

<div
  class="reading-progress"
  role="progressbar"
  aria-label={t(lang, 'post.progress')}
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  data-reading-progress
></div>

<div class="post-layout">
  <article data-pagefind-filter={`lang:${lang}`}>
    <div data-pagefind-body data-pagefind-filter="type:posts">
      <header class="post-header anim">
        <a class="post-back" href={`${base}/posts/`}>
          <ArrowLeft size={17} stroke-width={1.8} aria-hidden="true" />
          {t(lang, 'post.back')}
        </a>
        {post.data.series && <p class="post-series">{post.data.series}</p>}
        <h1 data-pagefind-meta="title">{post.data.title}</h1>
        <p class="post-deck">{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          {post.data.updatedDate && (
            <time datetime={post.data.updatedDate.toISOString()}>
              {tf(lang, 'post.updated', fmt(post.data.updatedDate))}
            </time>
          )}
          <span>{tf(lang, 'post.min', readMinutes)}</span>
        </div>
        {post.data.tags.length > 0 && (
          <ul class="tag-list post-tags" aria-label={lang === 'zh' ? '文章标签' : 'Post tags'}>
            {post.data.tags.map((tag) => (
              <li>
                <a class="tag" href={`${base}/tags/${encodeURIComponent(tag)}/`} data-pagefind-filter={`tag:${tag}`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </header>

      {toc.length > 0 && (
        <details class="mobile-toc anim" data-pagefind-ignore>
          <summary>{t(lang, 'post.mobileToc')}</summary>
          <nav aria-label={t(lang, 'post.toc')}>
            <ul class="toc-list">
              {toc.map((h2) => (
                <li>
                  <a href={`#${h2.slug}`} data-toc-link>{h2.text}</a>
                  {h2.children.length > 0 && (
                    <ul>
                      {h2.children.map((h3) => (
                        <li><a href={`#${h3.slug}`} data-toc-link>{h3.text}</a></li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}

      {post.data.cover && (
        <figure class="post-cover anim" data-pagefind-ignore>
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            widths={[720, 1040, 1440]}
            sizes="(max-width: 760px) calc(100vw - 28px), 70ch"
            loading="eager"
          />
        </figure>
      )}

      <div
        class="prose article-body anim"
        data-article-body
        data-heading-link-label={lang === 'zh' ? '链接到本节：' : 'Link to section: '}
      >
        <Content />
      </div>
    </div>

    {related.length > 0 && (
      <section class="related-posts" aria-labelledby="related-posts-title" data-pagefind-ignore>
        <h2 id="related-posts-title">{t(lang, 'post.related')}</h2>
        <ul>
          {related.map((candidate) => (
            <li>
              <a href={`${base}/posts/${candidate.id}/`}>
                <span>{candidate.data.title}</span>
                <time datetime={candidate.data.pubDate.toISOString()}>{fmt(candidate.data.pubDate)}</time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {(older || newer) && (
      <nav class="post-nav" aria-label={lang === 'zh' ? '文章导航' : 'Post navigation'} data-pagefind-ignore>
        {older ? (
          <a class="post-nav-link post-nav-link--older" href={`${base}/posts/${older.id}/`} rel="prev">
            <small>{t(lang, 'post.older')}</small>
            <span>{older.data.title}</span>
          </a>
        ) : <span></span>}
        {newer && (
          <a class="post-nav-link post-nav-link--newer" href={`${base}/posts/${newer.id}/`} rel="next">
            <small>{t(lang, 'post.newer')}</small>
            <span>{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}

    <div data-pagefind-ignore>
      <Giscus lang={lang} />
    </div>
  </article>

  {toc.length > 0 && (
    <aside class="toc" aria-label={t(lang, 'post.toc')} data-pagefind-ignore>
      <div class="toc-inner">
        <p class="toc-title">{t(lang, 'post.toc')}</p>
        <ul class="toc-list">
          {toc.map((h2) => (
            <li>
              <a href={`#${h2.slug}`} data-toc-link>{h2.text}</a>
              {h2.children.length > 0 && (
                <ul>
                  {h2.children.map((h3) => (
                    <li><a href={`#${h3.slug}`} data-toc-link>{h3.text}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </aside>
  )}
</div>

<template data-copy-button-template>
  <button
    class="copy-button"
    type="button"
    aria-label={t(lang, 'post.copy')}
    title={t(lang, 'post.copy')}
    data-label-copy={t(lang, 'post.copy')}
    data-label-copied={t(lang, 'post.copied')}
    data-label-failed={t(lang, 'post.copyFailed')}
  >
    <span class="copy-icon copy-icon--idle" aria-hidden="true"><Copy size={17} stroke-width={1.8} /></span>
    <span class="copy-icon copy-icon--success" aria-hidden="true"><Check size={17} stroke-width={2} /></span>
    <span class="copy-icon copy-icon--error" aria-hidden="true"><CircleX size={17} stroke-width={1.8} /></span>
    <span class="copy-live" aria-live="polite"></span>
  </button>
</template>

<script>
  function initializePostReading() {
    const articleBody = document.querySelector<HTMLElement>('[data-article-body]');
    const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
    const copyTemplate = document.querySelector<HTMLTemplateElement>('[data-copy-button-template]');

    if (articleBody) {
      const headingLabel = articleBody.dataset.headingLinkLabel ?? '';
      articleBody.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]').forEach((heading) => {
        if (heading.querySelector(':scope > .heading-anchor')) return;
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = `#${encodeURIComponent(heading.id)}`;
        anchor.textContent = '#';
        anchor.setAttribute('aria-label', `${headingLabel}${heading.textContent?.trim() ?? ''}`);
        heading.append(anchor);
      });

      if (copyTemplate && navigator.clipboard?.writeText) {
        articleBody.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
          if (pre.querySelector(':scope > .copy-button')) return;
          const code = pre.querySelector('code');
          const button = copyTemplate.content.firstElementChild?.cloneNode(true);
          if (!code || !(button instanceof HTMLButtonElement)) return;

          pre.classList.add('has-copy-button');
          pre.append(button);
          let resetTimer = 0;

          button.addEventListener('click', async () => {
            const copyLabel = button.dataset.labelCopy ?? '';
            const copiedLabel = button.dataset.labelCopied ?? '';
            const failedLabel = button.dataset.labelFailed ?? '';
            const live = button.querySelector<HTMLElement>('.copy-live');
            window.clearTimeout(resetTimer);

            try {
              await navigator.clipboard.writeText(code.textContent ?? '');
              button.dataset.state = 'success';
              button.setAttribute('aria-label', copiedLabel);
              button.title = copiedLabel;
              if (live) live.textContent = copiedLabel;
            } catch {
              button.dataset.state = 'error';
              button.setAttribute('aria-label', failedLabel);
              button.title = failedLabel;
              if (live) live.textContent = failedLabel;
            }

            resetTimer = window.setTimeout(() => {
              button.dataset.state = '';
              button.setAttribute('aria-label', copyLabel);
              button.title = copyLabel;
              if (live) live.textContent = '';
            }, 2200);
          });
        });
      }
    }

    const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const sectionHeadings = Array.from(
      new Set(
        tocLinks
          .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
          .filter((heading): heading is HTMLElement => heading instanceof HTMLElement),
      ),
    );

    let ticking = false;
    const updateReadingState = () => {
      ticking = false;

      if (progress && articleBody) {
        const top = articleBody.getBoundingClientRect().top + window.scrollY;
        const bottom = top + articleBody.offsetHeight;
        const start = top - Math.min(140, window.innerHeight * 0.2);
        const finish = Math.max(start + 1, bottom - window.innerHeight * 0.72);
        const amount = Math.min(1, Math.max(0, (window.scrollY - start) / (finish - start)));
        const percentage = Math.round(amount * 100);
        progress.style.width = `${percentage}%`;
        progress.setAttribute('aria-valuenow', String(percentage));
        progress.setAttribute('aria-valuetext', `${percentage}%`);
      }

      if (sectionHeadings.length > 0) {
        const threshold = window.scrollY + 130;
        let active = sectionHeadings[0];
        for (const heading of sectionHeadings) {
          if (heading.offsetTop <= threshold) active = heading;
        }
        tocLinks.forEach((link) => {
          const isActive = decodeURIComponent(link.hash.slice(1)) === active.id;
          link.classList.toggle('active', isActive);
          if (isActive) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
    };

    const queueReadingUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateReadingState);
    };

    window.addEventListener('scroll', queueReadingUpdate, { passive: true });
    window.addEventListener('resize', queueReadingUpdate, { passive: true });
    updateReadingState();
  }

  initializePostReading();
</script>

<style>
  .post-header {
    max-width: var(--reading);
    margin-bottom: 42px;
    text-align: left;
  }

  .post-back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }

  .post-back:hover {
    color: var(--accent-strong);
  }

  .post-series {
    margin: 1.5rem 0 0;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .post-header h1 {
    margin: 0.9rem 0 1rem;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
  }

  .post-deck {
    max-width: 62ch;
    margin: 0 0 1.25rem;
    color: var(--text-muted);
    font-family: var(--font-serif);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .post-meta {
    justify-content: flex-start;
  }

  .post-tags {
    margin-top: 1.2rem;
  }

  .post-cover {
    overflow: hidden;
    width: min(100%, var(--reading));
    margin: 0 0 42px;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: var(--surface-soft);
  }

  .post-cover :global(img) {
    width: 100%;
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-list ul {
    margin: 0;
    padding-left: 14px;
    list-style: none;
  }

  .mobile-toc .toc-list li + li {
    margin-top: 0.4rem;
  }

  .mobile-toc .toc-list a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    color: var(--text-muted);
    text-decoration: none;
  }

  .mobile-toc .toc-list a.active {
    color: var(--accent-strong);
  }

  :global(.article-body h2),
  :global(.article-body h3),
  :global(.article-body h4) {
    position: relative;
  }

  :global(.heading-anchor) {
    display: inline-flex;
    margin-left: 0.45rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72em;
    opacity: 0;
    text-decoration: none;
    transform: translateY(-0.05em);
  }

  :global(.article-body :is(h2, h3, h4):hover .heading-anchor),
  :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  :global(.article-body pre.has-copy-button) {
    padding-top: 3.5rem;
  }

  .copy-button {
    position: absolute;
    z-index: 1;
    top: 8px;
    right: 8px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--code-text) 28%, transparent);
    border-radius: 5px;
    background: color-mix(in srgb, var(--code-bg) 88%, transparent);
    color: var(--code-text);
    cursor: pointer;
  }

  .copy-button:hover {
    border-color: var(--accent);
    color: var(--accent-strong);
  }

  .copy-icon--success,
  .copy-icon--error {
    display: none;
  }

  .copy-button[data-state='success'] {
    color: var(--success);
  }

  .copy-button[data-state='success'] .copy-icon--idle,
  .copy-button[data-state='error'] .copy-icon--idle {
    display: none;
  }

  .copy-button[data-state='success'] .copy-icon--success,
  .copy-button[data-state='error'] .copy-icon--error {
    display: block;
  }

  .copy-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .related-posts {
    margin-top: 72px;
    padding-top: 30px;
    border-top: 1px solid var(--border);
  }

  .related-posts h2 {
    margin-bottom: 12px;
    font-size: 1.45rem;
  }

  .related-posts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-posts li {
    border-top: 1px solid var(--border);
  }

  .related-posts li:last-child {
    border-bottom: 1px solid var(--border);
  }

  .related-posts a {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    color: var(--text);
    text-decoration: none;
  }

  .related-posts a:hover span {
    color: var(--accent-strong);
  }

  .related-posts time {
    flex: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .post-nav small {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .post-nav span {
    display: block;
  }

  .post-nav-link--older {
    text-align: left;
  }

  .post-nav-link--newer {
    text-align: right;
  }

  @media (max-width: 760px) {
    .post-header h1 {
      font-size: 2.25rem;
    }

    .post-deck {
      font-size: 1.02rem;
    }

    .related-posts a {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
      padding-block: 14px;
    }

    .post-nav-link--newer {
      text-align: left;
    }

    :global(.heading-anchor) {
      opacity: 0.62;
    }
  }
</style>
